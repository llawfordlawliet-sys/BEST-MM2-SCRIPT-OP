-- Function to get player's current role
local function updateRole()
    for _, v in pairs(plr.Character:GetChildren()) do
        if v:IsA("Tool") then
            if v.Name == "Gun" then
                currentRole = "Sheriff"
                return
            elseif v.Name == "Knife" then
                currentRole = "Murderer"
                return
            end
        end
    end
    currentRole = "Innocent"
end

-- Get Murderer player (for Silent Aim)
local function getMurderer()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= plr and player.Character and player.Character:FindFirstChild("Knife") then
            return player
        end
    end
    return nil
end

-- Get all coins on ground (for auto-collect)
local function getCoins()
    local coins = {}
    for _, descendant in ipairs(Workspace:GetDescendants()) do
        if descendant:IsA("BasePart") and descendant.Name == "Coin" and descendant.Parent and not descendant.Parent:IsA("Tool") then
            table.insert(coins, descendant)
        end
    end
    return coins
end

-- Walk to coin (no teleport/fly)
local function walkToCoin(coin)
    if not coin or not coin.Parent then return false end
    
    local character = plr.Character
    if not character then return false end
    
    local humanoid = character:FindFirstChild("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    
    if not humanoid or not rootPart then return false end
    
    local originalSpeed = humanoid.WalkSpeed
    humanoid.WalkSpeed = 25
    
    local targetPos = coin.Position
    humanoid:MoveTo(targetPos)
    
    local timeout = 8
    local startTime = tick()
    
    repeat
        task.wait(0.1)
        local dist = (targetPos - rootPart.Position).Magnitude
        if dist <= 5 then
            humanoid:MoveTo(rootPart.Position)
            return true
        end
        humanoid:MoveTo(targetPos)
    until not coin.Parent or (tick() - startTime) > timeout
    
    humanoid.WalkSpeed = originalSpeed
    return false
end

-- ============================================
-- SILENT AIM (WORKS FOR SHERIFF IN MM2)
-- ============================================
local function getClosestMurderer()
    local murderer = getMurderer()
    if not murderer or not murderer.Character then return nil end
    
    local character = plr.Character
    if not character then return nil end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end
    
    local murdererRoot = murderer.Character:FindFirstChild("HumanoidRootPart")
    if not murdererRoot then return nil end
    
    return {
        player = murderer,
        rootPart = murdererRoot,
        distance = (murdererRoot.Position - rootPart.Position).Magnitude
    }
end

-- Silent aim execution - aims gun at murderer
local function updateSilentAim()
    if not silentAimEnabled then return end
    
    -- Check if player is Sheriff (has gun)
    local gun = plr.Character and plr.Character:FindFirstChild("Gun")
    if not gun then return end
    
    local murdererData = getClosestMurderer()
    if not murdererData then return end
    
    -- Get mouse and lock onto murderer
    local mouse = plr:GetMouse()
    local murdererHead = murdererData.player.Character:FindFirstChild("Head")
    
    if murdererHead then
        -- Convert world position to screen position
        local vector, onScreen = Workspace.CurrentCamera:WorldToScreenPoint(murdererHead.Position)
        if onScreen then
            -- Move mouse to murderer's head position (silent aim)
            mousemoverel(vector.X - mouse.X, vector.Y - mouse.Y)
            
            -- Auto-shoot when aimed
            if gun and gun:FindFirstChild("Fire") then
                local args = {mouse.Hit}
                gun.Fire:FireServer(unpack(args))
            end
        end
    end
end

-- Connect silent aim to render step
local silentAimConnection = nil
local function startSilentAim()
    if silentAimConnection then silentAimConnection:Disconnect() end
    silentAimConnection = RunService.RenderStepped:Connect(updateSilentAim)
end

local function stopSilentAim()
    if silentAimConnection then
        silentAimConnection:Disconnect()
        silentAimConnection = nil
    end
end

-- ============================================
-- AUTO COLLECT COINS
-- ============================================
local autoCollectConnection = nil
local isCollecting = false

local function startAutoCollect()
    if autoCollectConnection then autoCollectConnection:Disconnect() end
    
    autoCollectConnection = RunService.Heartbeat:Connect(function()
        if not autoCollectEnabled then return end
        
        local character = plr.Character
        if not character then return end
        
        local humanoid = character:FindFirstChild("Humanoid")
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not humanoid or not rootPart then return end
        
        local coins = getCoins()
        if #coins > 0 then
            local closestCoin = nil
            local closestDist = math.huge
            
            for _, coin in ipairs(coins) do
                local dist = (coin.Position - rootPart.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closestCoin = coin
                end
            end
            
            if closestCoin then
                walkToCoin(closestCoin)
            end
        end
    end)
end

local function stopAutoCollect()
    if autoCollectConnection then
        autoCollectConnection:Disconnect()
        autoCollectConnection = nil
    end
    
    local character = plr.Character
    if character then
        local humanoid = character:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = 16
        end
    end
end

