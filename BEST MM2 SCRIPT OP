burst.Texture = "rbxasset://textures/particles/sparkles_main.dds"
burst.Rate = 100
burst.Lifetime = NumberRange.new(0.5, 1)
burst.Speed = NumberRange.new(5, 15)
burst.Transparency = NumberSequence.new(1, 0)
burst.Parent = mainFrame

wait(0.5)
burst:Destroy()

print("Yagami Hub Loaded Successfully!")

