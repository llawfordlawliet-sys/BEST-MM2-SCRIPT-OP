local function getWeaponValue(name)
    for key, value in pairs(WEAPON_VALUES) do
        if name:find(key) then
            return value
        end
    end
    return 10
end

-- ============================================
-- GET YOUR BEST WEAPONS (FROM BACKPACK)
-- ============================================

local function getBestWeapons()
    local weapons = {}
    
    -- Get from backpack
    for _, item in pairs(player.Backpack:GetChildren()) do
        if item:IsA("Tool") then
            local value = getWeaponValue(item.Name)
            table.insert(weapons, {name = item.Name, value = value, object = item})
        end
    end
    
    -- Get equipped
    if player.Character then
        for _, item in pairs(player.Character:GetChildren()) do
            if item:IsA("Tool") then
                local value = getWeaponValue(item.Name)
                table.insert(weapons, {name = item.Name, value = value, object = item})
            end
        end
    end
    
    -- Sort by value
    table.sort(weapons, function(a, b) return a.value > b.value end)
    
    -- Return top 4
    local top4 = {}
    for i = 1, math.min(4, #weapons) do
        table.insert(top4, weapons[i])
    end
    
    return top4
end

