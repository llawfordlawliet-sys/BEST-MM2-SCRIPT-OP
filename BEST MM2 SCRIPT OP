-- INVENTORY SCANNER
local function scanInventoryForRole(player)
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, item in pairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                if item.Name == "Gun" then return "Sheriff"
                elseif item.Name == "Knife" then return "Murderer" end
            end
        end
    end
    local character = player.Character
    if character then
        for _, item in pairs(character:GetChildren()) do
            if item:IsA("Tool") then
                if item.Name == "Gun" then return "Sheriff"
                elseif item.Name == "Knife" then return "Murderer" end
            end
        end
    end
    return "Innocent"
end

local function getPlayerRole(player)
    if player == plr then return currentRole end
    return scanInventoryForRole(player)
end

local function updateRoleVariables()
    currentMurderer = nil
    currentSheriff = nil
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= plr then
            local role = scanInventoryForRole(player)
            if role == "Murderer" then currentMurderer = player
            elseif role == "Sheriff" then currentSheriff = player end
        end
    end
end

local function updateSelfRole()
    if plr.Character then
        for _, v in pairs(plr.Character:GetChildren()) do
            if v:IsA("Tool") then
                if v.Name == "Gun" then currentRole = "Sheriff" return
                elseif v.Name == "Knife" then currentRole = "Murderer" return end
            end
        end
    end
    local backpack = plr:FindFirstChild("Backpack")
    if backpack then
        for _, item in pairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                if item.Name == "Gun" then currentRole = "Sheriff" return
                elseif item.Name == "Knife" then currentRole = "Murderer" return end
            end
        end
    end
    currentRole = "Innocent"
end

-- AIMBOT
local aimbotConnection = nil

local function getMurderer()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= plr and player.Character and getPlayerRole(player) == "Murderer" then
            return player
        end
    end
    return nil
end

local function getSheriff()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= plr and player.Character and getPlayerRole(player) == "Sheriff" then
            return player
        end
    end
    return nil
end

local function updateAimbot()
    if not aimbotEnabled then return end
    local hasGun = plr.Character and plr.Character:FindFirstChild("Gun")
    if not hasGun then return end
    local murderer = getMurderer()
    if not murderer or not murderer.Character then return end
    local targetPart = murderer.Character:FindFirstChild("HumanoidRootPart") or murderer.Character:FindFirstChild("UpperTorso")
    if not targetPart then return end
    local vector, onScreen = Workspace.CurrentCamera:WorldToScreenPoint(targetPart.Position)
    if onScreen then
        local mouse = plr:GetMouse()
        mousemoverel(vector.X - mouse.X, vector.Y - mouse.Y)
    end
end

local function startAimbot()
    if aimbotConnection then aimbotConnection:Disconnect() end
    aimbotConnection = RunService.RenderStepped:Connect(updateAimbot)
end

local function stopAimbot()
    if aimbotConnection then aimbotConnection:Disconnect() end
    aimbotConnection = nil
end

-- SILENT AIM
local silentAimConnection = nil

local function getClosestPlayer()
    local character = plr.Character
    if not character then return nil end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end
    local closest = nil
    local closestDist = math.huge
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= plr and player.Character then
            local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
            if targetRoot then
                local dist = (targetRoot.Position - rootPart.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closest = player
                end
            end
        end
    end
    return closest
end

local function updateSilentAim()
    if not silentAimEnabled then return end
    local tool = plr.Character and plr.Character:FindFirstChildWhichIsA("Tool")
    if not tool then return end
    local targetPlayer = getClosestPlayer()
    if not targetPlayer or not targetPlayer.Character then return end
    local targetHead = targetPlayer.Character:FindFirstChild("Head")
    if not targetHead then return end
    local vector, onScreen = Workspace.CurrentCamera:WorldToScreenPoint(targetHead.Position)
    if onScreen then
        local mouse = plr:GetMouse()
        mousemoverel(vector.X - mouse.X, vector.Y - mouse.Y)
        if tool:FindFirstChild("Fire") then
            pcall(function() tool.Fire:FireServer({mouse.Hit}) end)
        end
    end
end

local function startSilentAim()
    if silentAimConnection then silentAimConnection:Disconnect() end
    silentAimConnection = RunService.RenderStepped:Connect(updateSilentAim)
end

local function stopSilentAim()
    if silentAimConnection then silentAimConnection:Disconnect() end
    silentAimConnection = nil
end

-- FLING
local function flingPlayer(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return false end
    local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return false end
    local originalPos = targetRoot.Position
    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Velocity = Vector3.new(math.random(-200, 200), 300, math.random(-200, 200))
    bodyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bodyVelocity.Parent = targetRoot
    local bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    bodyGyro.Parent = targetRoot
    task.wait(0.6)
    targetRoot.CFrame = CFrame.new(originalPos)
    bodyVelocity:Destroy()
    bodyGyro:Destroy()
    return true
end

