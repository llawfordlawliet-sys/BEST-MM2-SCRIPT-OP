-- ========== ANIMATION FUNCTIONS (works on all executors) ==========
local TweenService = game:GetService("TweenService")

local function animateGlow()
    local tween = TweenService:Create(glowCircle, TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {Rotation = 360})
    tween:Play()
end

local function pulseTitle()
    local tween = TweenService:Create(titleLabel, TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {TextStrokeTransparency = 0.1})
    tween:Play()
end

-- ========== SIMULATED LOADING (replace with your actual loading) ==========
local loadingSteps = {
    {text = "Initializing...", percent = 10},
    {text = "Loading assets...", percent = 25},
    {text = "Connecting to server...", percent = 40},
    {text = "Setting up environment...", percent = 55},
    {text = "Preparing UI...", percent = 70},
    {text = "Almost ready...", percent = 85},
    {text = "Finalizing...", percent = 95},
    {text = "Welcome!", percent = 100}
}

local function startLoading()
    -- Play loading sound
    pcall(function() loadingSound:Play() end)
    
    -- Start animations
    animateGlow()
    pulseTitle()
    
    local currentStep = 1
    
    -- Loading loop
    for percent = 1, 100 do
        task.wait(0.025) -- ~2.5 seconds total loading time
        
        -- Update progress bar
        progressFill.Size = UDim2.new(percent / 100, 0, 1, 0)
        percentText.Text = percent .. "%"
        
        -- Update subtitle based on progress
        if currentStep <= #loadingSteps and percent >= loadingSteps[currentStep].percent then
            subtitleText.Text = loadingSteps[currentStep].text
            currentStep = currentStep + 1
        end
        
        -- Pulse effect on progress bar
        local hue = 0.55 + (percent / 100) * 0.2
        progressFill.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
        
        -- Slight vibration effect on circle (optional)
        local offset = math.sin(percent * 0.5) * 2
        glowCircle.Position = UDim2.new(0.5, -100 + offset, 0.5, -100 + offset)
    end
    
    -- Loading complete - transition
    transitionToMainMenu()
end

-- ========== TRANSITION EFFECT ==========
local function transitionToMainMenu()
    -- Play transition sound
    pcall(function() transitionSound:Play() end)
    pcall(function() loadingSound:Stop() end)
    
    -- Create flash overlay
    local flashOverlay = Instance.new("Frame")
    flashOverlay.Size = UDim2.new(1, 0, 1, 0)
    flashOverlay.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    flashOverlay.BackgroundTransparency = 1
    flashOverlay.Parent = gui
    
    -- Flash animation
    local flashTween = TweenService:Create(flashOverlay, TweenInfo.new(0.15, Enum.EasingStyle.Linear), {BackgroundTransparency = 0})
    flashTween:Play()
    
    task.wait(0.15)
    
    -- Shrink loading frame
    local shrinkTween = TweenService:Create(loadingFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0)})
    shrinkTween:Play()
    
    -- Show and expand main menu
    mainMenuFrame.Visible = true
    mainMenuFrame.Size = UDim2.new(0, 0, 0, 0)
    
    local expandTween = TweenService:Create(mainMenuFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 1, 0)})
    expandTween:Play()
    
    task.wait(0.5)
    flashOverlay:Destroy()
    loadingFrame:Destroy()
    
    setupMainMenu()
end

-- ========== MAIN MENU SETUP ==========
local function setupMainMenu()
    -- Menu title
    local menuTitle = Instance.new("TextLabel")
    menuTitle.Size = UDim2.new(0.6, 0, 0.12, 0)
    menuTitle.Position = UDim2.new(0.2, 0, 0.1, 0)
    menuTitle.BackgroundTransparency = 1
    menuTitle.Text = "MAIN MENU"
    menuTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
    menuTitle.TextScaled = true
    menuTitle.Font = Enum.Font.GothamBold
    menuTitle.TextStrokeTransparency = 0.3
    menuTitle.TextStrokeColor3 = Color3.fromRGB(0, 200, 255)
    menuTitle.Parent = mainMenuFrame
    
    -- Menu gradient
    local menuGradient = Instance.new("UIGradient")
    menuGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(10, 10, 25)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(25, 10, 40)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(10, 10, 25))
    })
    menuGradient.Parent = mainMenuFrame
    
    -- Rotating gradient animation
    task.spawn(function()
        local rotation = 0
        while mainMenuFrame and mainMenuFrame.Visible do
            rotation = (rotation + 0.5) % 360
            menuGradient.Rotation = rotation
            task.wait(0.05)
        end
    end)
    
    -- Menu particles
    local menuParticles = particleEmitter:Clone()
    menuParticles.Rate = 30
    menuParticles.Parent = mainMenuFrame
    
    -- Buttons
    local buttons = {"PLAY", "SETTINGS", "CREDITS", "EXIT"}
    local yPositions = {0.3, 0.45, 0.6, 0.75}
    
    for i, btnText in ipairs(buttons) do
        local button = Instance.new("TextButton")
        button.Size = UDim2.new(0.3, 0, 0.08, 0)
        button.Position = UDim2.new(0.35, 0, yPositions[i], 0)
        button.Text = btnText
        button.TextColor3 = Color3.fromRGB(255, 255, 255)
        button.TextScaled = true
        button.Font = Enum.Font.GothamBold
        button.BackgroundColor3 = Color3.fromRGB(30, 30, 50)
        button.BorderSizePixel = 0
        button.Parent = mainMenuFrame
        
        -- Button hover effects
        button.MouseEnter:Connect(function()
            button.BackgroundColor3 = Color3.fromRGB(50, 50, 80)
            button.TextColor3 = Color3.fromRGB(0, 200, 255)
            pcall(function() clickSound:Play() end)
        end)
        
        button.MouseLeave:Connect(function()
            button.BackgroundColor3 = Color3.fromRGB(30, 30, 50)
            button.TextColor3 = Color3.fromRGB(255, 255, 255)
        end)
        
        -- Button click handler
        button.MouseButton1Click:Connect(function()
            pcall(function() clickSound:Play() end)
            
            if btnText == "EXIT" then
                pcall(function() game:Shutdown() end)
            elseif btnText == "PLAY" then
                menuTitle.Text = "Starting Game..."
                task.wait(1)
                -- Add your game start logic here
                print("Game started!")
            elseif btnText == "SETTINGS" then
                print("Settings clicked")
            elseif btnText == "CREDITS" then
                print("Credits clicked")
            end
        end)
    end
    
    -- Version text
    local versionText = Instance.new("TextLabel")
    versionText.Size = UDim2.new(0.3, 0, 0.04, 0)
    versionText.Position = UDim2.new(0.35, 0, 0.9, 0)
    versionText.BackgroundTransparency = 1
    versionText.Text = "v1.0.0"
    versionText.TextColor3 = Color3.fromRGB(100, 100, 150)
    versionText.TextScaled = true
    versionText.Font = Enum.Font.Gotham
    versionText.Parent = mainMenuFrame
end

-- ========== START THE GUI ==========
print("Universal Loading GUI Started - Works on Delta and all executors!")
startLoading()
