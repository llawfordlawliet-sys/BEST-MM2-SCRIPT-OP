-- Automatic round check (every 2 seconds)
local function checkForRoundStart()
    updateRoleVariables()
    
    local currentTime = tick()
    if currentTime - lastRoundCheck < 2 then return end
    lastRoundCheck = currentTime
    
    -- Check if roles exist
    local hasMurderer = lastMurderer ~= nil
    local hasSheriff = lastSheriff ~= nil
    local currentRoundActive = hasMurderer or hasSheriff
    
    -- Round started detection
    if currentRoundActive and not roundActive then
        roundActive = true
        
        -- Show notification for each role
        if lastMurderer then
            createFancyNotification("MURDERER", lastMurderer.Name .. " is the Murderer!", Color3.fromRGB(255, 50, 50))
        end
        if lastSheriff then
            createFancyNotification("SHERIFF", lastSheriff.Name .. " is the Sheriff!", Color3.fromRGB(50, 150, 255))
        end
    elseif not currentRoundActive and roundActive then
        roundActive = false
    end
end

-- ============================================
-- NOCLIP / FLY FUNCTIONALITY
-- ============================================
local function setNoclip(state)
    noclipEnabled = state
    local character = plr.Character
    if character then
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = not state
            end
        end
    end
end

local function flyToPosition(targetPos)
    local character = plr.Character
    if not character then return false end
    
    local humanoid = character:FindFirstChild("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    
    if not humanoid or not rootPart then return false end
    
    setNoclip(true)
    
    local originalSpeed = humanoid.WalkSpeed
    local originalPlatform = humanoid.PlatformStand
    
    humanoid.WalkSpeed = 25
    humanoid.PlatformStand = true
    
    local distance = (targetPos - rootPart.Position).Magnitude
    local duration = math.max(0.1, distance / 25)
    
    local flyTween = TweenService:Create(rootPart, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        Position = targetPos
    })
    flyTween:Play()
    flyTween.Completed:Wait()
    
    humanoid.PlatformStand = originalPlatform
    humanoid.WalkSpeed = originalSpeed
    setNoclip(false)
    
    return true
end

local function getMurderer()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= plr and player.Character and getPlayerRole(player) == "Murderer" then
            return player
        end
    end
    return nil
end

local function getSheriff()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= plr and player.Character and getPlayerRole(player) == "Sheriff" then
            return player
        end
    end
    return nil
end

local function getClosestPlayer()
    local character = plr.Character
    if not character then return nil end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end
    
    local closest = nil
    local closestDist = math.huge
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= plr and player.Character then
            local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
            if targetRoot then
                local dist = (targetRoot.Position - rootPart.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closest = player
                end
            end
        end
    end
    
    return closest
end

local function getCoins()
    local coins = {}
    local possibleCoinNames = {"Coin", "Money", "coin", "money", "Gem", "gem", "Token", "token", "Gold", "gold"}
    
    for _, descendant in ipairs(Workspace:GetDescendants()) do
        if descendant:IsA("BasePart") and descendant.Parent then
            local nameLower = descendant.Name:lower()
            local isValidCoin = false
            
            for _, coinName in ipairs(possibleCoinNames) do
                if nameLower:find(coinName:lower()) then
                    isValidCoin = true
                    break
                end
            end
            
            if not isValidCoin and descendant:GetAttribute("Coin") then
                isValidCoin = true
            end
            
            if isValidCoin and descendant.Parent and not descendant.Parent:IsA("Tool") and not descendant.Parent:IsA("Player") then
                if descendant:FindFirstChild("TouchInterest") then
                    table.insert(coins, descendant)
                end
            end
        end
    end
    return coins
end

-- ============================================
-- FLING FUNCTION
-- ============================================
local function flingPlayer(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return false end
    
    local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return false end
    
    local originalPos = targetRoot.Position
    local flingDirection = Vector3.new(math.random(-150, 150), 200, math.random(-150, 150))
    local flingVelocity = flingDirection
    
    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Velocity = flingVelocity
    bodyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bodyVelocity.Parent = targetRoot
    
    task.wait(0.5)
    
    targetRoot.CFrame = CFrame.new(originalPos)
    bodyVelocity:Destroy()
    
    return true
end

-- ============================================
-- AIMLOCK (MURDERER ONLY)
-- ============================================
local aimlockConnection = nil

local function updateAimlock()
    if not aimlockEnabled then return end
    
    local hasGun = plr.Character and plr.Character:FindFirstChild("Gun")
    if not hasGun then return end
    
    local murderer = getMurderer()
    if not murderer or not murderer.Character then
        currentAimlockTarget = nil
        return
    end
    
    local targetPart = murderer.Character:FindFirstChild("HumanoidRootPart")
    if not targetPart then
        targetPart = murderer.Character:FindFirstChild("UpperTorso")
    end
    if not targetPart then return end
    
    currentAimlockTarget = murderer
    
    local mouse = plr:GetMouse()
    local vector, onScreen = Workspace.CurrentCamera:WorldToScreenPoint(targetPart.Position)
    
    if onScreen then
        local deltaX = vector.X - mouse.X
        local deltaY = vector.Y - mouse.Y
        local smoothFactor = 0.35
        mousemoverel(deltaX * smoothFactor, deltaY * smoothFactor)
    end
end

local function startAimlock()
    if aimlockConnection then aimlockConnection:Disconnect() end
    aimlockConnection = RunService.RenderStepped:Connect(updateAimlock)
end

local function stopAimlock()
    if aimlockConnection then
        aimlockConnection:Disconnect()
        aimlockConnection = nil
    end
    currentAimlockTarget = nil
end

-- ============================================
-- UNIVERSAL SILENT AIM
-- ============================================
local silentAimConnection = nil

local function updateSilentAim()
    if not silentAimEnabled then return end
    
    local tool = plr.Character and plr.Character:FindFirstChildWhichIsA("Tool")
    if not tool then return end
    
    local targetPlayer = getClosestPlayer()
    if not targetPlayer or not targetPlayer.Character then return end
    
    local targetHead = targetPlayer.Character:FindFirstChild("Head")
    if not targetHead then return end
    
    local mouse = plr:GetMouse()
    local vector, onScreen = Workspace.CurrentCamera:WorldToScreenPoint(targetHead.Position)
    
    if onScreen then
        mousemoverel(vector.X - mouse.X, vector.Y - mouse.Y)
        
        if tool:FindFirstChild("Fire") then
            local args = {mouse.Hit}
            tool.Fire:FireServer(unpack(args))
        end
    end
end

