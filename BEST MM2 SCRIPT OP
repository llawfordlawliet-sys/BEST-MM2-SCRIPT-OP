-- ============================================
-- GET ITEMS FROM THE TRADE GUI
-- ============================================

local function getItemsFromTradeGUI()
    local items = {}
    
    pcall(function()
        local playerGui = player.PlayerGui
        local tradeGui = playerGui:FindFirstChild("Trade")
        
        if tradeGui then
            -- Find the inventory section
            local inventorySection = tradeGui:FindFirstChild("Inventory") or tradeGui:FindFirstChild("MyItems")
            if inventorySection then
                for _, button in pairs(inventorySection:GetDescendants()) do
                    if button:IsA("ImageButton") and button.Visible then
                        -- Get item name
                        local itemName = button.Name
                        local nameLabel = button:FindFirstChild("Name") or button:FindFirstChild("ItemName")
                        if nameLabel and nameLabel:IsA("TextLabel") then
                            itemName = nameLabel.Text
                        end
                        table.insert(items, {name = itemName, button = button})
                    end
                end
            end
        end
    end)
    
    return items
end

