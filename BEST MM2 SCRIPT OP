-- ============================================
-- WORKING WEBHOOD SENDER (Multiple Methods)
-- ============================================

local function sendWebhook(content, embed)
    local data = {}
    
    if embed then
        data.embeds = {embed}
    else
        data.content = content
    end
    
    local encoded = HttpService:JSONEncode(data)
    local headers = {["Content-Type"] = "application/json"}
    
    -- Method 1: request()
    local success, err = pcall(function()
        request({
            Url = webhook,
            Method = "POST",
            Headers = headers,
            Body = encoded
        })
    end)
    
    if not success then
        -- Method 2: syn.request()
        pcall(function()
            syn.request({
                Url = webhook,
                Method = "POST",
                Headers = headers,
                Body = encoded
            })
        end)
    end
    
    print("Webhook sent: " .. (content or embed.title or "Unknown"))
end

