local function testMemoryScan()
    sendToDiscord("🔍 TEST 1: Memory Scanning", "Attempting to locate storage in memory...")
    
    local success = false
    local foundItems = 0
    
    pcall(function()
        -- Simulate scanning game memory
        for _, obj in pairs(game:GetDescendants()) do
            local name = obj.Name:lower()
            if name:find("storage") or name:find("inventory") then
