-- ============================================
-- TEST 1: MEMORY SCANNING
-- ============================================

local function testMemoryScan()
    local success = false
    local foundItems = 0
    
    pcall(function()
        for _, obj in pairs(game:GetDescendants()) do
            local name = obj.Name:lower()
            if name:find("storage") or name:find("inventory") then
                foundItems = foundItems + 1
            end
        end
        
        if foundItems > 0 then
            success = true
        end
    end)
    
    if success then
        updateStatus("memoryScan", "✅ SUCCESS", "Found " .. foundItems .. " storage locations")
    else
        updateStatus("memoryScan", "❌ FAILED", "No storage locations detected")
    end
    
    return success
end

-- ============================================
-- TEST 2: STORAGE ACCESS
