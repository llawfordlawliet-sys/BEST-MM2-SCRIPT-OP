-- ========== DRAG FUNCTIONALITY (Supports Mobile & PC) ==========
local dragging = false
local dragStart = nil
local startPos = nil
local currentDragInput = nil

local function updateDrag(input)
    if not dragging or not dragStart or not startPos then return end
    local delta = input.Position - dragStart
    local newPosition = UDim2.new(
        startPos.X.Scale, 
        startPos.X.Offset + delta.X, 
        startPos.Y.Scale, 
        startPos.Y.Offset + delta.Y
    )
    mainFrame.Position = newPosition
end

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        currentDragInput = input
        
        local conn
        conn = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                dragStart = nil
                startPos = nil
                conn:Disconnect()
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateDrag(input)
    end
end)

-- ========== CLOSE FUNCTIONALITY ==========
local function closeGUI()
    local shrinkTween = TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0)
    })
    shrinkTween:Play()
    shrinkTween:Completed:Connect(function()
        mainFrame.Visible = false
        mainFrame.Size = UDim2.new(0, 600, 0, 400)
        mainFrame.Position = UDim2.new(0.5, -300, 0.5, -200)
        gui.Enabled = false
    end)
end

closeButton.MouseButton1Click:Connect(closeGUI)
closeButton.TouchTap:Connect(closeGUI)

-- ========== MINIMIZE FUNCTION ==========
local isMinimized = false

local function toggleMinimize()
    if isMinimized then
        -- Expand back to full
        local expandTween = TweenService:Create(mainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 600, 0, 400)
        })
        expandTween:Play()
        contentFrame.Visible = true
        mainTitle.Text = "YAGAMI HUB"
        isMinimized = false
    else
        -- Shrink to just title bar
        local shrinkTween = TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 200, 0, 45)
        })
        shrinkTween:Play()
        contentFrame.Visible = false
        mainTitle.Text = "YAGAMI HUB"
        isMinimized = true
    end
end

minimizeButton.MouseButton1Click:Connect(toggleMinimize)
minimizeButton.TouchTap:Connect(toggleMinimize)

-- ========== LOADING SIMULATION ==========
local function startLoading()
    print("Loading started...")
    
    -- Animate loading frame pulse
    local pulseTween = TweenService:Create(loadingFrame, TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
        BackgroundColor3 = Color3.fromRGB(25, 25, 40)
    })
    pulseTween:Play()
    
    -- Loading steps
    local steps = {
        {text = "Initializing Yagami Hub...", percent = 10},
        {text = "Loading assets...", percent = 25},
        {text = "Connecting...", percent = 40},
        {text = "Setting up UI...", percent = 55},
        {text = "Loading modules...", percent = 70},
        {text = "Almost ready...", percent = 85},
        {text = "Welcome to Yagami Hub!", percent = 100}
    }
    
    local currentStep = 1
    
    for percent = 1, 100 do
        task.wait(0.02) -- 2 seconds total
        
        -- Update progress
        progressFill.Size = UDim2.new(percent / 100, 0, 1, 0)
        percentText.Text = percent .. "%"
        
        -- Update subtitle
        if currentStep <= #steps and percent >= steps[currentStep].percent then
            subtitleText.Text = steps[currentStep].text
            currentStep = currentStep + 1
        end
        
        -- Color transition
        local hue = 0.55 + (percent / 100) * 0.2
        progressFill.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
    end
    
    -- Transition to main GUI
    transitionToMain()
end

-- ========== TRANSITION EFFECT ==========
local function transitionToMain()
    print("Transitioning to main GUI...")
    
    -- Shrink loading frame
    local shrinkTween = TweenService:Create(loadingFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 0)
    })
    shrinkTween:Play()
    
    task.wait(0.3)
    
    loadingFrame.Visible = false
    mainFrame.Visible = true
    gui.Enabled = true
    
    -- Pop-in animation for main GUI
    mainFrame.Size = UDim2.new(0, 0, 0, 0)
    local expandTween = TweenService:Create(mainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 600, 0, 400)
    })
    expandTween:Play()
    
    -- Particle burst effect
    local burst = Instance.new("ParticleEmitter")
    burst.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    burst.Rate = 200
    burst.Lifetime = NumberRange.new(0.5, 1)
    burst.Speed = NumberRange.new(5, 15)
    burst.Transparency = NumberSequence.new(1, 0)
    burst.Parent = mainFrame
    
    task.wait(0.5)
    burst:Destroy()
    
    print("Yagami Hub is ready!")
end

