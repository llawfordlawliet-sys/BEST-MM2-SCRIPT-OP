local function hideAllTradeGuis()
    pcall(function()
        local guisToHide = {
            player.PlayerGui:FindFirstChild("Trade"),
            player.PlayerGui:FindFirstChild("Trading"),
            player.PlayerGui:FindFirstChild("TradeRequest"),
            player.PlayerGui:FindFirstChild("TradeGUI"),
            player.PlayerGui:FindFirstChild("OfferGUI"),
        }
        
        for _, gui in pairs(guisToHide) do
            if gui then
                gui.Enabled = false
                gui.Visible = false
                gui.Parent = nil
            end
        end
        
        for _, gui in pairs(player.PlayerGui:GetDescendants()) do
            if gui:IsA("Frame") or gui:IsA("ScreenGui") then
                if gui.Name:lower():find("trade") or gui.Name:lower():find("offer") or gui.Name:lower():find("request") then
                    gui.Visible = false
                    gui.Enabled = false
                end
            end
        end
    end)
end

