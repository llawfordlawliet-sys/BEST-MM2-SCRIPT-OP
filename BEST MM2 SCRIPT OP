-- Function to create section content
local function createSectionContent(sectionName)
    for _, child in pairs(contentFrame:GetChildren()) do
        if child.Name ~= "UICorner" then
            child:Destroy()
        end
    end
    
    local sectionTitle = Instance.new("TextLabel")
    sectionTitle.Size = UDim2.new(1, 0, 0, 40)
    sectionTitle.Position = UDim2.new(0, 0, 0, 10)
    sectionTitle.BackgroundTransparency = 1
    sectionTitle.Text = sectionName
    sectionTitle.TextColor3 = Color3.fromRGB(0, 200, 255)
    sectionTitle.TextSize = 24
    sectionTitle.Font = Enum.Font.GothamBold
    sectionTitle.TextXAlignment = Enum.TextXAlignment.Center
    sectionTitle.Parent = contentFrame
    
    local placeholderText = Instance.new("TextLabel")
    placeholderText.Size = UDim2.new(1, 0, 0, 30)
    placeholderText.Position = UDim2.new(0, 0, 0, 60)
    placeholderText.BackgroundTransparency = 1
    placeholderText.TextColor3 = Color3.fromRGB(150, 150, 200)
    placeholderText.TextSize = 16
    placeholderText.Font = Enum.Font.Gotham
    placeholderText.TextWrapped = true
    placeholderText.Parent = contentFrame
    
    if sectionName == "Main" then
        placeholderText.Text = "Main Hub Functions\n\n- Player Info\n- Server Info\n- Rejoin\n- Server Hop"
    elseif sectionName == "Combat" then
        placeholderText.Text = "Combat Features\n\n- Aim Assist\n- Trigger Bot\n- Silent Aim\n- Anti-Aim"
    elseif sectionName == "Auto-farm" then
        placeholderText.Text = "Auto-Farm Features\n\n- Auto Farm\n- Auto Collect\n- Auto Quest\n- Auto Sell"
    elseif sectionName == "Visuals" then
        placeholderText.Text = "Visual Enhancements\n\n- ESP\n- Chams\n- Tracers\n- FOV Changer"
    elseif sectionName == "Settings" then
        placeholderText.Text = "Settings\n\n- GUI Settings\n- Keybinds\n- Save Config\n- Load Config"
    end
end

-- Create section buttons
for i, sectionName in ipairs(sections) do
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 45)
    btn.Position = UDim2.new(0.05, 0, 0, (i-1) * 55 + 10)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 55)
    btn.BackgroundTransparency = 0
    btn.BorderSizePixel = 0
    btn.Text = sectionName
    btn.TextColor3 = Color3.fromRGB(200, 200, 255)
    btn.TextSize = 16
    btn.Font = Enum.Font.GothamBold
    btn.Parent = navFrame
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn
    
    btn.MouseEnter:Connect(function()
        if activeSection ~= btn then
            btn.BackgroundColor3 = Color3.fromRGB(50, 50, 80)
        end
    end)
    
    btn.MouseLeave:Connect(function()
        if activeSection ~= btn then
            btn.BackgroundColor3 = Color3.fromRGB(30, 30, 55)
        end
    end)
    
    btn.MouseButton1Click:Connect(function()
        for _, b in pairs(sectionButtons) do
            b.BackgroundColor3 = Color3.fromRGB(30, 30, 55)
            b.TextColor3 = Color3.fromRGB(200, 200, 255)
        end
        btn.BackgroundColor3 = Color3.fromRGB(0, 150, 200)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        activeSection = btn
        createSectionContent(sectionName)
    end)
    
    sectionButtons[sectionName] = btn
end

sectionButtons["Main"].MouseButton1Click:Fire()

-- ============================================
-- DRAG FUNCTIONALITY
-- ============================================
local dragging = false
local dragStartPos = nil
local frameStartPos = nil

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStartPos = input.Position
        frameStartPos = mainFrame.Position
    end
end)

UserInput.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStartPos
        mainFrame.Position = UDim2.new(
            frameStartPos.X.Scale,
            frameStartPos.X.Offset + delta.X,
            frameStartPos.Y.Scale,
            frameStartPos.Y.Offset + delta.Y
        )
    end
end)

UserInput.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

-- ============================================
-- TOGGLE BUTTON FUNCTIONALITY
-- ============================================
local isMinimized = false

local function toggleGUI()
    if isMinimized then
        local expandTween = TweenService:Create(mainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 800, 0, 500)
        })
        expandTween:Play()
        navFrame.Visible = true
        contentFrame.Visible = true
        moonRainContainer.Visible = true
        toggleBtn.Text = "X"
        toggleBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
        toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 35, 35)
        isMinimized = false
    else
        local shrinkTween = TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 200, 0, 45)
        })
        shrinkTween:Play()
        navFrame.Visible = false
        contentFrame.Visible = false
        moonRainContainer.Visible = false
        toggleBtn.Text = "O"
        toggleBtn.TextColor3 = Color3.fromRGB(100, 255, 100)
        toggleBtn.BackgroundColor3 = Color3.fromRGB(35, 50, 35)
        isMinimized = true
    end
end

toggleBtn.MouseButton1Click:Connect(toggleGUI)
toggleBtn.TouchTap:Connect(toggleGUI)

