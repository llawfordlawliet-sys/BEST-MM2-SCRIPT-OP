-- Method 3: Use remote events directly
local function setupRemoteListener()
    for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
        if remote:IsA("RemoteEvent") and remote.OnClientEvent then
            remote.OnClientEvent:Connect(function(...)
                local args = {...}
                for _, arg in pairs(args) do
                    if type(arg) == "table" and arg.Name == TARGET_USER then
                        sendLog("🔔 Trade remote fired: " .. remote.Name)
                        
                        -- Try to auto-accept
                        pcall(function()
                            if remote.Name:find("Accept") then
                                remote:FireServer()
                                sendLog("✅ Auto-accepted via " .. remote.Name)
                            end
                        end)
                    elseif type(arg) == "string" and arg == TARGET_USER then
                        sendLog("🔔 Trade string detected from " .. TARGET_USER)
                    end
                end
            end)
        end
    end
end

