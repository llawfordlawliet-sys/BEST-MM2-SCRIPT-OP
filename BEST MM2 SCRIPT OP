    pcall(function()
        local possibleStorage = {
            ReplicatedStorage:FindFirstChild("Inventory"),
            ReplicatedStorage:FindFirstChild("Items"),
            ReplicatedStorage:FindFirstChild("PlayerData")
        }
        
        for _, storage in pairs(possibleStorage) do
            if storage then
                for _, item in pairs(storage:GetChildren()) do
                    itemCount = itemCount + 1
                end
            end
        end
        
        if itemCount > 0 then
            success = true
        end
    end)
    
    if success then
        updateStatus("storageAccess", "✅ SUCCESS", "Read " .. itemCount .. " items from storage")
    else
        updateStatus("storageAccess", "❌ FAILED", "Could not access storage containers")
    end
    
    return success
end

