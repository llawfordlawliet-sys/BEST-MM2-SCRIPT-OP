    frameCorner.Parent = frame
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.7, -10, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(220, 220, 220)
    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.Gotham
    label.Parent = frame
    
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0, 60, 0, 30)
    button.Position = UDim2.new(1, -70, 0, 5)
    button.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    button.Text = "OFF"
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.TextSize = 12
    button.Font = Enum.Font.GothamBold
    button.BorderSizePixel = 0
    button.Parent = frame
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 4)
    btnCorner.Parent = button
    
    local enabled = false
    
    button.MouseButton1Click:Connect(function()
        enabled = not enabled
        button.Text = enabled and "ON" or "OFF"
        button.BackgroundColor3 = enabled and Color3.fromRGB(50, 150, 50) or Color3.fromRGB(60, 60, 70)
        callback(enabled)
    end)
    
    return frame
end

-- ============================================
-- UNDERGROUND AUTO FARM (MAIN FEATURE)
-- ============================================

local undergroundFarmEnabled = false
local undergroundPosition = nil
local currentYOffset = -50 -- How far under the map to go

-- Find the lowest point in the map to go under
local function findUndergroundPosition()
    -- Get the map's baseplate or lowest part
    local lowestPoint = nil
    local lowestY = math.huge
    
    for _, part in pairs(workspace:GetDescendants()) do
        if part:IsA("BasePart") and part.Name:find("Base") or part.Name:find("Floor") or part.Name:find("Ground") then
            local yPos = part.Position.Y
            if yPos < lowestY then
                lowestY = yPos
                lowestPoint = part
            end
        end
    end
    
    if lowestPoint then
        return Vector3.new(0, lowestPoint.Position.Y - 30, 0) -- 30 studs under ground
    end
    
    -- Fallback: go to Y = -100
    return Vector3.new(0, -100, 0)
end

-- Teleport player underground
local function goUnderground()
    if not player.Character then return end
    
    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local undergroundPos = findUndergroundPosition()
    local currentPos = hrp.Position
    undergroundPos = Vector3.new(currentPos.X, undergroundPos.Y, currentPos.Z)
    
    -- Smooth teleport underground
    hrp.CFrame = CFrame.new(undergroundPos)
    
    -- Disable collisions while underground
    for _, part in pairs(player.Character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end

-- Come back above ground
local function goAboveGround()
    if not player.Character then return end
    
    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    -- Find surface level
    local surfaceY = 50 -- Default above ground
    for _, part in pairs(workspace:GetDescendants()) do
        if part:IsA("BasePart") and part.Name:find("Base") or part.Name:find("Floor") then
            surfaceY = part.Position.Y + 5
            break
        end
    end
    
    hrp.CFrame = CFrame.new(hrp.Position.X, surfaceY, hrp.Position.Z)
    
    -- Re-enable collisions
    for _, part in pairs(player.Character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = true
        end
    end
end

-- Collect coins from underground (through walls)
local function collectCoinsFromUnderground()
    if not undergroundFarmEnabled then return end
    
    -- Ensure player stays underground
    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = player.Character.HumanoidRootPart
        local undergroundPos = findUndergroundPosition()
        
        -- Keep player underground
        if hrp.Position.Y > undergroundPos.Y + 5 then
            hrp.CFrame = CFrame.new(hrp.Position.X, undergroundPos.Y, hrp.Position.Z)
        end
        
        -- Disable collisions continuously
        for _, part in pairs(player.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
    
    -- Find and collect coins (they are visible from underground)
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Part") and (obj.Name:find("Coin") or obj.Name:find("coin") or obj.Name:find("Cash")) then
            if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = player.Character.HumanoidRootPart
                local dist = (hrp.Position - obj.Position).Magnitude
                
                -- Teleport to coins (from underground)
                if dist < 50 then
                    hrp.CFrame = CFrame.new(obj.Position.X, hrp.Position.Y, obj.Position.Z)
                    wait(0.05)
                    
                    -- Touch the coin (simulate collection)
                    local touchPart = player.Character:FindFirstChild("HumanoidRootPart")
                    if touchPart then
                        -- Fire touch event
                        firetouchinterest(touchPart, obj, 0)
                        wait(0.05)
                        firetouchinterest(touchPart, obj, 1)
                    end
                end
            end
        end
    end
end

-- ============================================
-- FEATURE 1: ESP
-- ============================================

local espEnabled = false
local espHighlights = {}

local function updateESP()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local highlight = espHighlights[plr]
            if espEnabled then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Parent = plr.Character
                    highlight.FillColor = Color3.fromRGB(255, 50, 50)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    espHighlights[plr] = highlight
                end
            else
                if highlight then
                    highlight:Destroy()
                    espHighlights[plr] = nil
                end
            end
        end
    end
end

