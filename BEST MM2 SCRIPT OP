local stepIndex = 1

-- FIXED LOADING LOOP
for percent = 1, 100 do
    task.wait(0.02)
    
    -- Update progress bar
    progressFill.Size = UDim2.new(percent / 100, 0, 1, 0)
    percentText.Text = percent .. "%"
    
    -- Force GUI refresh
    RunService.Heartbeat:Wait()
    
    -- Update subtitle
    if percent >= stepIndex * 14 and stepIndex <= #loadingSteps then
        subText.Text = loadingSteps[stepIndex]
        stepIndex = stepIndex + 1
    end
    
    -- Update color
    local hue = 0.55 + (percent / 100) * 0.2
    progressFill.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
end

