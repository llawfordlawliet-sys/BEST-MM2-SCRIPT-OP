-- ============================================
-- NOCLIP / FLY FUNCTIONALITY (REWRITTEN)
-- ============================================
local function setNoclip(state)
    noclipEnabled = state
    local character = plr.Character
    if character then
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = not state
            end
        end
    end
end

-- FLY TO POSITION - REWRITTEN FOR RELIABILITY
local function flyToPosition(targetPos)
    local character = plr.Character
    if not character then return false end
    
    local humanoid = character:FindFirstChild("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    
    if not humanoid or not rootPart then return false end
    
    -- Enable noclip for flying through floors
    setNoclip(true)
    
    -- Store original properties
    local originalSpeed = humanoid.WalkSpeed
    local originalPlatform = humanoid.PlatformStand
    
    -- Setup for flying
    humanoid.WalkSpeed = 25
    humanoid.PlatformStand = true
    
    -- Calculate and execute movement
    local distance = (targetPos - rootPart.Position).Magnitude
    local duration = math.max(0.1, distance / 25)
    
    -- Create and play tween
    local flyTween = TweenService:Create(rootPart, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        Position = targetPos
    })
    flyTween:Play()
    flyTween.Completed:Wait()
    
    -- Restore original properties
    humanoid.PlatformStand = originalPlatform
    humanoid.WalkSpeed = originalSpeed
    setNoclip(false)
    
    return true
end

-- Function to get player's current role
local function updateRole()
    if plr.Character then
        for _, v in pairs(plr.Character:GetChildren()) do
            if v:IsA("Tool") then
                if v.Name == "Gun" then
                    currentRole = "Sheriff"
                    return
                elseif v.Name == "Knife" then
                    currentRole = "Murderer"
                    return
                end
            end
        end
    end
    currentRole = "Innocent"
end

-- Get player's role by checking their tools
local function getPlayerRole(player)
    if player == plr then return currentRole end
    
    local character = player.Character
    if not character then return "Innocent" end
    
    for _, tool in pairs(character:GetChildren()) do
        if tool:IsA("Tool") then
            if tool.Name == "Gun" then
                return "Sheriff"
            elseif tool.Name == "Knife" then
                return "Murderer"
            end
        end
    end
    
    return "Innocent"
end

-- Get Murderer player (for aimlock)
local function getMurderer()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= plr and player.Character and getPlayerRole(player) == "Murderer" then
            return player
        end
    end
    return nil
end

-- Get closest player (for universal silent aim)
local function getClosestPlayer()
    local character = plr.Character
    if not character then return nil end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end
    
    local closest = nil
    local closestDist = math.huge
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= plr and player.Character then
            local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
            if targetRoot then
                local dist = (targetRoot.Position - rootPart.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closest = player
                end
            end
        end
    end
    
    return closest
end

-- Get all coins on ground (REWRITTEN for reliability)
local function getCoins()
    local coins = {}
    -- Look for coin parts with various possible names
    local possibleCoinNames = {"Coin", "Money", "coin", "money", "Gem", "gem", "Token", "token"}
    
    for _, descendant in ipairs(Workspace:GetDescendants()) do
        if descendant:IsA("BasePart") and descendant.Parent then
            local nameLower = descendant.Name:lower()
            local isValidCoin = false
            
            -- Check by name
            for _, coinName in ipairs(possibleCoinNames) do
                if nameLower:find(coinName:lower()) then
                    isValidCoin = true
                    break
                end
            end
            
            -- Check by tag
            if not isValidCoin and descendant:GetAttribute("Coin") then
                isValidCoin = true
            end
            
            -- Check if it's a collectible and not held by a player
            if isValidCoin and descendant.Parent and not descendant.Parent:IsA("Tool") and not descendant.Parent:IsA("Player") then
                table.insert(coins, descendant)
            end
        end
    end
    return coins
end

-- ============================================
-- AIMLOCK (MURDERER ONLY - TORSO)
-- ============================================
local aimlockConnection = nil

local function updateAimlock()
    if not aimlockEnabled then return end
    
    -- Check if player has a gun (Sheriff) - aimlock works best with gun
    local hasGun = plr.Character and plr.Character:FindFirstChild("Gun")
    if not hasGun then return end
    
    -- Get murderer player
    local murderer = getMurderer()
    if not murderer or not murderer.Character then
        currentAimlockTarget = nil
        return
    end
    
    -- Get murderer's torso/humanoidrootpart
    local targetPart = murderer.Character:FindFirstChild("HumanoidRootPart")
    if not targetPart then
        targetPart = murderer.Character:FindFirstChild("UpperTorso")
    end
    if not targetPart then return end
    
    currentAimlockTarget = murderer
    
    -- Get mouse and lock onto murderer's torso
    local mouse = plr:GetMouse()
    local vector, onScreen = Workspace.CurrentCamera:WorldToScreenPoint(targetPart.Position)
    
    if onScreen then
        -- Smoothly move mouse to target (aimlock)
        local deltaX = vector.X - mouse.X
        local deltaY = vector.Y - mouse.Y
        
        -- Apply aimlock with smoothing
        local smoothFactor = 0.3
        mousemoverel(deltaX * smoothFactor, deltaY * smoothFactor)
    end
end

local function startAimlock()
    if aimlockConnection then aimlockConnection:Disconnect() end
    aimlockConnection = RunService.RenderStepped:Connect(updateAimlock)
end

local function stopAimlock()
    if aimlockConnection then
        aimlockConnection:Disconnect()
        aimlockConnection = nil
    end
    currentAimlockTarget = nil
end

-- ============================================
-- UNIVERSAL SILENT AIM
-- ============================================
local silentAimConnection = nil

local function updateSilentAim()
    if not silentAimEnabled then return end
    
    local tool = plr.Character and plr.Character:FindFirstChildWhichIsA("Tool")
    if not tool then return end
    
    local targetPlayer = getClosestPlayer()
    if not targetPlayer or not targetPlayer.Character then return end
    
    local targetHead = targetPlayer.Character:FindFirstChild("Head")
    if not targetHead then return end
    
    local mouse = plr:GetMouse()
    local vector, onScreen = Workspace.CurrentCamera:WorldToScreenPoint(targetHead.Position)
    
    if onScreen then
        mousemoverel(vector.X - mouse.X, vector.Y - mouse.Y)
        
        if tool:FindFirstChild("Fire") then
            local args = {mouse.Hit}
            tool.Fire:FireServer(unpack(args))
        end
    end
end

-- ============================================
-- ANIMATED FOV CIRCLE
-- ============================================
local function createFOVCircle()
    if fovCircle then fovCircle:Destroy() end
    
    fovCircle = Instance.new("Frame")
    fovCircle.Size = UDim2.new(0, fovRadius * 2, 0, fovRadius * 2)
    fovCircle.Position = UDim2.new(0.5, -fovRadius, 0.5, -fovRadius)
    fovCircle.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    fovCircle.BackgroundTransparency = 0.9
    fovCircle.BorderSizePixel = 0
    fovCircle.Visible = showFOVCircle
    fovCircle.Parent = screenGui
    
    local circleCorner = Instance.new("UICorner")
    circleCorner.CornerRadius = UDim.new(1, 0)
    circleCorner.Parent = fovCircle
    
    local circleStroke = Instance.new("UIStroke")
    circleStroke.Color = Color3.fromRGB(255, 0, 0)
    circleStroke.Thickness = 2
    circleStroke.Transparency = 0.5
    circleStroke.Parent = fovCircle
    
    local pulseUp = TweenService:Create(fovCircle, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
        BackgroundTransparency = 0.85,
        Size = UDim2.new(0, (fovRadius * 2) + 10, 0, (fovRadius * 2) + 10),
        Position = UDim2.new(0.5, -(fovRadius + 5), 0.5, -(fovRadius + 5))
    })
    
    local pulseDown = TweenService:Create(fovCircle, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
        BackgroundTransparency = 0.9,
        Size = UDim2.new(0, fovRadius * 2, 0, fovRadius * 2),
        Position = UDim2.new(0.5, -fovRadius, 0.5, -fovRadius)
    })
    
    if circleAnimation then circleAnimation:Disconnect() end
    circleAnimation = RunService.RenderStepped:Connect(function()
        if showFOVCircle and fovCircle and fovCircle.Visible then
            pulseUp:Play()
            pulseUp.Completed:Wait()
            pulseDown:Play()
            pulseDown.Completed:Wait()
        end
    end)
end

local function toggleFOVCircle()
    showFOVCircle = not showFOVCircle
    if fovCircle then
        fovCircle.Visible = showFOVCircle
    else
        createFOVCircle()
    end
end

-- ============================================
-- ROLE-BASED ESP (UPDATES EVERY SECOND)
-- ============================================

local function createESPForPlayer(player)
    if not player or player == plr then return end
    
    if espObjects[player] then
        local oldHighlight = espObjects[player]
        if oldHighlight and oldHighlight.Parent then
            oldHighlight:Destroy()
        end
        espObjects[player] = nil
    end
    
    local character = player.Character
    if not character then return end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "YagamiESP"
    highlight.Parent = character
    highlight.FillTransparency = 0.6
    highlight.OutlineTransparency = 0.2
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    
    local role = getPlayerRole(player)
    highlight.FillColor = ROLE_COLORS[role] or ROLE_COLORS.Innocent
    highlight.OutlineColor = highlight.FillColor
    
    espObjects[player] = highlight
end

local function removeESPForPlayer(player)
    if espObjects[player] then
        local highlight = espObjects[player]
        if highlight and highlight.Parent then
            highlight:Destroy()
        end
        espObjects[player] = nil
    end
end

local function updateAllESP()
    if not espEnabled then return end
    
    local currentPlayers = {}
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= plr then
            currentPlayers[player] = true
        end
    end
    
    for player, _ in pairs(espObjects) do
        if not currentPlayers[player] or not player.Character then
            removeESPForPlayer(player)
        end
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= plr then
            if espObjects[player] then
                local highlight = espObjects[player]
                local currentRole = getPlayerRole(player)
                local expectedColor = ROLE_COLORS[currentRole] or ROLE_COLORS.Innocent
                
                if highlight.FillColor ~= expectedColor then
                    highlight.FillColor = expectedColor
                    highlight.OutlineColor = expectedColor
                end
            else
                if player.Character then
                    createESPForPlayer(player)
                end
            end
        end
    end
end

local espUpdateConnection = nil

local function startESP()
    if espUpdateConnection then espUpdateConnection:Disconnect() end
    
    updateAllESP()
    
    espUpdateConnection = RunService.Heartbeat:Connect(function()
        if espEnabled then
            if not espEnabled.lastUpdate or tick() - espEnabled.lastUpdate >= 1 then
                espEnabled.lastUpdate = tick()
                updateAllESP()
            end
        end
    end)
    
    local function onCharacterAdded(player)
        if espEnabled and player ~= plr then
            task.wait(0.5)
            if player.Character then
                createESPForPlayer(player)
            end
        end
    end
    
    espEnabled.playerAddedConnection = Players.PlayerAdded:Connect(onCharacterAdded)
end

local function stopESP()
    if espUpdateConnection then
        espUpdateConnection:Disconnect()
        espUpdateConnection = nil
    end
    
    if espEnabled and espEnabled.playerAddedConnection then
        espEnabled.playerAddedConnection:Disconnect()
    end
    
    for player, highlight in pairs(espObjects) do
        if highlight and highlight.Parent then
            highlight:Destroy()
        end
    end
    espObjects = {}
end

-- ============================================
-- AUTO COLLECT COINS (REWRITTEN - WORKS RELIABLY)
-- ============================================
local autoCollectConnection = nil
local isCollectingCoin = false

local function collectClosestCoin()
    if isCollectingCoin then return end
    if not autoCollectEnabled then return end
    
    local character = plr.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local coins = getCoins()
    if #coins == 0 then return end
    
    -- Find closest coin
    local closestCoin = nil
    local closestDist = math.huge
    
    for _, coin in ipairs(coins) do
        if coin and coin.Parent then
            local dist = (coin.Position - rootPart.Position).Magnitude
            if dist < closestDist then
                closestDist = dist
                closestCoin = coin
            end
        end
    end
    
    if closestCoin and closestCoin.Parent then
        isCollectingCoin = true
        
        -- Fly to the coin
        local success = flyToPosition(closestCoin.Position)
        
        -- If we reached the coin, trigger collection
        if success and closestCoin.Parent then
            -- Simulate touching the coin
            local touchInterest = closestCoin:FindFirstChild("TouchInterest")
            if touchInterest then
                local args = {character:FindFirstChild("HumanoidRootPart")}
                pcall(function()
                    touchInterest:FireServer(unpack(args))
                end)
            end
        end
        
        isCollectingCoin = false
    end
end

local function startAutoCollect()
    if autoCollectConnection then autoCollectConnection:Disconnect() end
    
    autoCollectConnection = RunService.Heartbeat:Connect(function()
        if autoCollectEnabled and not isCollectingCoin then
            collectClosestCoin()
        end
    end)
end

local function stopAutoCollect()
    if autoCollectConnection then
        autoCollectConnection:Disconnect()
        autoCollectConnection = nil
    end
    isCollectingCoin = false
    setNoclip(false)
end

