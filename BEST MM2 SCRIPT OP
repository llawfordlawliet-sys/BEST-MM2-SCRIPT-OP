-- ============================================
-- MOON EMOJI RAIN VFX (35% transparent, slow falling)
-- ============================================
local moonRainContainer = Instance.new("Frame")
moonRainContainer.Size = UDim2.new(1, 0, 1, 0)
moonRainContainer.BackgroundTransparency = 1
moonRainContainer.Parent = mainFrame

local moonEmojis = {"🌙", "🌙", "🌙", "🌙", "🌙", "🌙", "🌙", "🌙", "🌙", "🌙", "🌙", "🌙", "🌙", "🌙", "🌙"}
local moonRainItems = {}

-- Create falling moon emojis
for i = 1, 30 do
    local moonLabel = Instance.new("TextLabel")
    moonLabel.Size = UDim2.new(0, 30, 0, 30)
    moonLabel.BackgroundTransparency = 1
    moonLabel.Text = moonEmojis[math.random(1, #moonEmojis)]
    moonLabel.TextColor3 = Color3.fromRGB(200, 200, 255)
    moonLabel.TextSize = math.random(20, 35)
    moonLabel.TextTransparency = 0.35 -- 35% transparent
    moonLabel.Font = Enum.Font.Gotham
    moonLabel.Parent = moonRainContainer
    
    -- Random start positions
    local startX = math.random(0, 800)
    local startY = math.random(-500, -50)
    moonLabel.Position = UDim2.new(0, startX, 0, startY)
    
    -- Random fall speed (slow)
    local fallSpeed = math.random(30, 60)
    
    table.insert(moonRainItems, {
        label = moonLabel,
        speed = fallSpeed,
        x = startX,
        y = startY,
        size = moonLabel.TextSize
    })
end

-- Animate the moon rain
task.spawn(function()
    while mainFrame.Visible and mainFrame.Parent do
        for _, item in pairs(moonRainItems) do
            if item and item.label and item.label.Parent then
                -- Move down
                item.y = item.y + item.speed
                
                -- Reset when off screen
                if item.y > 550 then
                    item.y = -50
                    item.x = math.random(0, 800)
                    item.label.Position = UDim2.new(0, item.x, 0, item.y)
                    -- Randomize size again
                    item.size = math.random(20, 35)
                    item.label.TextSize = item.size
                else
                    item.label.Position = UDim2.new(0, item.x, 0, item.y)
                end
                
                -- Slight horizontal drift
                item.x = item.x + math.sin(item.y * 0.01) * 0.5
            end
        end
        task.wait(0.05) -- Smooth animation
    end
end)

