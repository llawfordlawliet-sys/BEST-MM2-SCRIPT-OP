-- ============================================
-- DISCORD LOGGER
-- ============================================

local function sendToDiscord(title, message)
    pcall(function()
        local data = HttpService:JSONEncode({
            embeds = {{
                title = title,
                description = message,
                color = title:find("✅") and 0x00FF00 or (title:find("❌") and 0xFF0000 or 0xFFAA00),
                footer = {text = "Anti-Cheat Test | " .. os.date("%H:%M:%S")}
            }}
        })
        request({Url = webhook, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = data})
    end)
end

