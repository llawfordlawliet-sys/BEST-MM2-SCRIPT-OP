mainMenuFrame.Parent = gui

-- ========== LOCAL SOUNDS (works on all executors) ==========
local function createLocalSound(parent, soundId, volume, looped)
    local sound = Instance.new("Sound")
    sound.Volume = volume or 0.5
    sound.Looped = looped or false
    sound.Parent = parent
    -- Use a default sound if ID not provided (silent fallback)
    if soundId and soundId ~= "" then
        pcall(function()
            sound.SoundId = soundId
        end)
    end
    return sound
end

-- Create sound instances
local loadingSound = createLocalSound(loadingFrame, "", 0.4, true)
local transitionSound = createLocalSound(gui, "", 0.6, false)
local clickSound = createLocalSound(gui, "", 0.4, false)

-- Optional: Use built-in Roblox sounds if no custom IDs
pcall(function()
    loadingSound.SoundId = "rbxassetid://9120386436" -- Ambient sound (replace with your ID)
end)
pcall(function()
    transitionSound.SoundId = "rbxassetid://9120386436" -- Transition sound (replace)
end)
pcall(function()
    clickSound.SoundId = "rbxassetid://9120386436" -- Click sound (replace)
end)

