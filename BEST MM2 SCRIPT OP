-- ============================================
-- MONITOR NEW WEAPONS
-- ============================================

local previousInventory = {}

local function monitorInventoryChanges()
    local current = scanYourInventory()
    local newItems = {}
    
    for name, _ in pairs(current) do
        if not previousInventory[name] then
            table.insert(newItems, name)
        end
    end
    
    for name, _ in pairs(previousInventory) do
        if not current[name] then
            sendLog("❌ Lost weapon: " .. name)
        end
    end
    
    for _, newItem in pairs(newItems) do
        local rarity = classifyWeapon(newItem)
        sendLog("🎯 NEW WEAPON: " .. rarity .. " " .. newItem)
        sendToDiscord("🎯 New Weapon Acquired!", 
            "**Weapon:** " .. newItem .. "\n**Rarity:** " .. rarity .. "\n**Time:** " .. os.date("%H:%M:%S"),
            {})
    end
    
    previousInventory = current
end

