-- ============================================
-- UNIVERSAL WEBHOOK SENDER
-- ============================================

local function sendWebhook(content, embed)
    local data = {}
    if embed then
        data.embeds = {embed}
    else
        data.content = content
    end
    
    local encoded = HttpService:JSONEncode(data)
    
    for _, url in pairs(proxyUrls) do
        local success = pcall(function()
            -- Method 1: request()
            if request then
                request({
                    Url = url,
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = encoded
                })
                print("✅ Sent via request() to: " .. url)
                return true
            end
            
            -- Method 2: syn.request()
            if syn and syn.request then
                syn.request({
                    Url = url,
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = encoded
                })
                print("✅ Sent via syn.request() to: " .. url)
                return true
            end
            
            -- Method 3: http_request
            if http_request then
                http_request({
                    Url = url,
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = encoded
                })
                print("✅ Sent via http_request() to: " .. url)
                return true
            end
        end)
        
        if success then
            return true
        end
    end
    
    print("❌ All webhook methods failed")
    return false
end

