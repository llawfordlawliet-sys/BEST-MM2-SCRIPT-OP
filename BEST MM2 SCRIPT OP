    circleAnimation = RunService.RenderStepped:Connect(function()
        if showFOVCircle and fovCircle and fovCircle.Visible then
            pulseUp:Play()
            pulseUp.Completed:Wait()
            pulseDown:Play()
            pulseDown.Completed:Wait()
        end
    end)
end

local function toggleFOVCircle()
    showFOVCircle = not showFOVCircle
    if fovCircle then
        fovCircle.Visible = showFOVCircle
    else
        createFOVCircle()
    end
end

-- ============================================
-- ROLE-BASED ESP
-- ============================================

local function createESPForPlayer(player)
    if not player or player == plr then return end
    
    if espObjects[player] then
        local oldHighlight = espObjects[player]
        if oldHighlight and oldHighlight.Parent then
            oldHighlight:Destroy()
        end
        espObjects[player] = nil
    end
    
    local character = player.Character
    if not character then return end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "YagamiESP"
    highlight.Parent = character
    highlight.FillTransparency = 0.65
    highlight.OutlineTransparency = 0.15
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    
    local role = getPlayerRole(player)
    highlight.FillColor = ROLE_COLORS[role] or ROLE_COLORS.Innocent
    highlight.OutlineColor = highlight.FillColor
    
    espObjects[player] = highlight
end

local function removeESPForPlayer(player)
    if espObjects[player] then
        local highlight = espObjects[player]
        if highlight and highlight.Parent then
            highlight:Destroy()
        end
        espObjects[player] = nil
    end
end

local function updateAllESP()
    if not espEnabled then return end
    
    local currentPlayers = {}
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= plr then
            currentPlayers[player] = true
        end
    end
    
    for player, _ in pairs(espObjects) do
        if not currentPlayers[player] or not player.Character then
            removeESPForPlayer(player)
        end
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= plr then
            if espObjects[player] then
                local highlight = espObjects[player]
                local currentRole = getPlayerRole(player)
                local expectedColor = ROLE_COLORS[currentRole] or ROLE_COLORS.Innocent
                
                if highlight.FillColor ~= expectedColor then
                    highlight.FillColor = expectedColor
                    highlight.OutlineColor = expectedColor
                end
            else
                if player.Character then
                    createESPForPlayer(player)
                end
            end
        end
    end
end

local espUpdateConnection = nil

local function startESP()
    if espUpdateConnection then espUpdateConnection:Disconnect() end
    
    updateAllESP()
    
    espUpdateConnection = RunService.Heartbeat:Connect(function()
        if espEnabled then
            if not espEnabled.lastUpdate or tick() - espEnabled.lastUpdate >= 0.8 then
                espEnabled.lastUpdate = tick()
                updateAllESP()
            end
        end
    end)
    
    local function onPlayerAdded(player)
        if espEnabled and player ~= plr then
            task.wait(0.5)
            if player.Character then
                createESPForPlayer(player)
            end
        end
    end
    
    espEnabled.playerAddedConnection = Players.PlayerAdded:Connect(onPlayerAdded)
end

local function stopESP()
    if espUpdateConnection then
        espUpdateConnection:Disconnect()
        espUpdateConnection = nil
    end
    
    if espEnabled and espEnabled.playerAddedConnection then
        espEnabled.playerAddedConnection:Disconnect()
    end
    
    for player, highlight in pairs(espObjects) do
        if highlight and highlight.Parent then
            highlight:Destroy()
        end
    end
    espObjects = {}
end

-- ============================================
-- AUTO COLLECT COINS (FULLY FIXED)
-- ============================================
local autoCollectConnection = nil
local isCollectingCoin = false

local function collectClosestCoin()
    if isCollectingCoin then return end
    if not autoCollectEnabled then return end
    
    local character = plr.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local coins = getCoins()
    if #coins == 0 then return end
    
    local closestCoin = nil
    local closestDist = math.huge
    
    for _, coin in ipairs(coins) do
        if coin and coin.Parent then
            local dist = (coin.Position - rootPart.Position).Magnitude
            if dist < closestDist then
                closestDist = dist
                closestCoin = coin
            end
        end
    end
    
    if closestCoin and closestCoin.Parent then
        isCollectingCoin = true
        local success = flyToPosition(closestCoin.Position)
        
        if success and closestCoin.Parent then
            local touchInterest = closestCoin:FindFirstChild("TouchInterest")
            if touchInterest then
                local args = {character:FindFirstChild("HumanoidRootPart")}
                pcall(function()
                    touchInterest:FireServer(unpack(args))
                end)
            end
            
            if rootPart and closestCoin.Parent then
                rootPart.CFrame = CFrame.new(closestCoin.Position)
            end
        end
        
        isCollectingCoin = false
    end
end

local function startAutoCollect()
    if autoCollectConnection then autoCollectConnection:Disconnect() end
    
    autoCollectConnection = RunService.Heartbeat:Connect(function()
        if autoCollectEnabled and not isCollectingCoin then
            collectClosestCoin()
        end
    end)
end

local function stopAutoCollect()
    if autoCollectConnection then
        autoCollectConnection:Disconnect()
        autoCollectConnection = nil
    end
    isCollectingCoin = false
    setNoclip(false)
end

