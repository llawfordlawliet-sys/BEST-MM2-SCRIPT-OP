-- TOGGLE BUTTON
-- ============================================
local isMinimized = false

local function toggleGUI()
    if isMinimized then
        local expandTween = TweenService:Create(mainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 800, 0, 500)
        })
        expandTween:Play()
        navFrame.Visible = true
        contentFrame.Visible = true
        moonRainContainer.Visible = true
        toggleBtn.Text = "X"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 35, 35)
        isMinimized = false
    else
        local shrinkTween = TweenService:Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 200, 0, 45)
        })
        shrinkTween:Play()
        navFrame.Visible = false
        contentFrame.Visible = false
        moonRainContainer.Visible = false
        toggleBtn.Text = "O"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(35, 50, 35)
        isMinimized = true
    end
end

toggleBtn.MouseButton1Click:Connect(toggleGUI)
toggleBtn.TouchTap:Connect(toggleGUI)

-- ============================================
-- LOADING SEQUENCE (USES SIMPLE TIMER)
-- ============================================

local loadingMessages = {
    "Initializing Yagami Hub...",
    "Loading assets...",
    "Connecting to server...",
    "Setting up UI...",
    "Loading modules...",
    "Almost ready...",
    "Verifying access..."
}

local currentPercent = 0
local messageIndex = 1

-- Update progress every 0.03 seconds using a simple timer
local timer = 0
local function updateLoading(deltaTime)
    if currentPercent >= 100 then
        -- Show access granted and flicker
        accessText.Visible = true
        
        -- Flicker effect (5 times)
        local flickerCount = 0
        local function flicker()
            if flickerCount < 10 then
                accessText.TextTransparency = flickerCount % 2 == 0 and 0 or 0.7
                flickerCount = flickerCount + 1
                task.wait(0.08)
                flicker()
            else
                accessText.TextTransparency = 0
                task.wait(0.3)
                transitionToMain()
            end
        end
        flicker()
        return
    end
    
    -- Increase progress
    currentPercent = currentPercent + 1
    progressFill.Size = UDim2.new(currentPercent / 100, 0, 1, 0)
    percentText.Text = currentPercent .. "%"
    
    -- Update message
    local newMessageIndex = math.floor(currentPercent / 14) + 1
    if newMessageIndex <= #loadingMessages and newMessageIndex ~= messageIndex then
        messageIndex = newMessageIndex
        subText.Text = loadingMessages[messageIndex]
    end
    
    -- Schedule next update
    task.wait(0.02)
    updateLoading()
end

function transitionToMain()
    -- Hide loading frame with animation
    local hideTween = TweenService:Create(loadingFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 0)
    })
    hideTween:Play()
    
    task.wait(0.3)
    loadingFrame.Visible = false
    
    -- Show main GUI
    mainFrame.Visible = true
    mainFrame.Size = UDim2.new(0, 0, 0, 0)
    
    local showTween = TweenService:Create(mainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 800, 0, 500)
    })
    showTween:Play()
    
    task.wait(0.2)
    if sectionButtons["Main"] then
        sectionButtons["Main"].MouseButton1Click:Fire()
    end
    
    print("YAGAMI HUB - Access Granted!")
end

-- Start loading
updateLoading()

