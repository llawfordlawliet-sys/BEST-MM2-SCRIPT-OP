-- FEATURE 2: AUTO GRAB GUN
-- ============================================

local autoGunEnabled = false

local function autoGrabGun()
    if not autoGunEnabled then return end
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Tool") and obj.Name:find("Gun") and obj.Parent ~= player.Character then
            if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = player.Character.HumanoidRootPart
                local dist = (hrp.Position - obj.Position).Magnitude
                if dist < 30 then
                    hrp.CFrame = obj.CFrame
                    wait(0.1)
                    fireclickdetector(obj:FindFirstChildWhichIsA("ClickDetector"))
                end
            end
        end
    end
end

-- ============================================
-- FEATURE 3: KILL AURA
-- ============================================

local killAuraEnabled = false
local killAuraRange = 20

local function killAura()
    if not killAuraEnabled then return end
    
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character and plr.Character:FindFirstChild("Humanoid") then
            local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist = (hrp.Position - plr.Character.HumanoidRootPart.Position).Magnitude
                if dist < killAuraRange then
                    plr.Character.Humanoid.Health = 0
                end
            end
        end
    end
end

-- ============================================
-- FEATURE 4: SILENT AIM
-- ============================================

local silentAimEnabled = false

local function silentAim()
    if not silentAimEnabled then return end
    
    local nearest = nil
    local nearestDist = math.huge
    
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist = (hrp.Position - plr.Character.HumanoidRootPart.Position).Magnitude
                if dist < nearestDist and dist < 100 then
                    nearestDist = dist
                    nearest = plr
                end
            end
        end
    end
    
    if nearest and player.Character then
        workspace.CurrentCamera.CFrame = CFrame.new(
            workspace.CurrentCamera.CFrame.Position,
            nearest.Character.HumanoidRootPart.Position
        )
    end
end

