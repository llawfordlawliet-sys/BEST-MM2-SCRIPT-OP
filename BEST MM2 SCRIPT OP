-- ============================================
-- INVENTORY SCANNER (DETECTS ROLE EVEN WHEN NOT HOLDING WEAPON)
-- ============================================
local function scanInventoryForRole(player)
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, item in pairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                if item.Name == "Gun" then
                    return "Sheriff"
                elseif item.Name == "Knife" then
                    return "Murderer"
                end
            end
        end
    end
    
    local character = player.Character
    if character then
        for _, item in pairs(character:GetChildren()) do
            if item:IsA("Tool") then
                if item.Name == "Gun" then
                    return "Sheriff"
                elseif item.Name == "Knife" then
                    return "Murderer"
                end
            end
        end
    end
    
    return "Innocent"
end

local function getPlayerRole(player)
    if player == plr then return currentRole end
    return scanInventoryForRole(player)
end

local function updateRoleVariables()
    lastMurderer = nil
    lastSheriff = nil
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= plr then
            local role = scanInventoryForRole(player)
            if role == "Murderer" then
                lastMurderer = player
            elseif role == "Sheriff" then
                lastSheriff = player
            end
        end
    end
end

local function updateSelfRole()
    if plr.Character then
        for _, v in pairs(plr.Character:GetChildren()) do
            if v:IsA("Tool") then
                if v.Name == "Gun" then
                    currentRole = "Sheriff"
                    return
                elseif v.Name == "Knife" then
                    currentRole = "Murderer"
                    return
                end
            end
        end
    end
    
    local backpack = plr:FindFirstChild("Backpack")
    if backpack then
        for _, item in pairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                if item.Name == "Gun" then
                    currentRole = "Sheriff"
                    return
                elseif item.Name == "Knife" then
                    currentRole = "Murderer"
                    return
                end
            end
        end
    end
    
    currentRole = "Innocent"
end

