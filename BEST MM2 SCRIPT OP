local autoFarmEnabled = false
local farmConnection = nil
local currentTarget = nil
local targetCooldown = false
local COINS_WALKSPEED = 25

-- Function to get all coin parts in the underground area
local function getUndergroundCoins()
    local coins = {}
    -- Look for coin parts with common names (customize based on your game)
    local possibleCoinNames = {"Coin", "Money", "Gem", "Crystal", "Token", "Collectible"}
    
    for _, descendant in ipairs(Workspace:GetDescendants()) do
        if descendant:IsA("BasePart") and descendant.Parent then
            local nameLower = descendant.Name:lower()
            local isValidCoin = false
            
            -- Check if it's a coin by name or tag
            for _, coinName in ipairs(possibleCoinNames) do
                if nameLower:find(coinName:lower()) then
                    isValidCoin = true
                    break
                end
            end
            
            -- Also check for a "Coin" tag or custom attribute
            if not isValidCoin and descendant:IsA("BasePart") then
                if descendant:GetAttribute("Coin") or descendant:GetAttribute("Collectible") then
                    isValidCoin = true
                end
            end
            
            if isValidCoin and descendant ~= currentTarget then
                -- Check if coin is underground (Y position less than a threshold, adjust as needed)
                -- For underground, check if Y is low or if it's in a cave zone
                local isUnderground = descendant.Position.Y < 50 -- Adjust this threshold based on your game
                
                if isUnderground and descendant:FindFirstChild("TouchInterest") then
                    table.insert(coins, descendant)
                end
            end
        end
    end
    
    return coins
end

-- Function to walk to a target without teleporting or flying
local function walkToTarget(target)
    if not target or not target.Parent then return false end
    
    local character = plr.Character
    if not character then return false end
    
    local humanoid = character:FindFirstChild("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    
    if not humanoid or not rootPart then return false end
    
    -- Store original walkspeed
    local originalWalkSpeed = humanoid.WalkSpeed
    
    -- Set to desired walkspeed
    humanoid.WalkSpeed = COINS_WALKSPEED
    
    -- Calculate direction to target
    local targetPos = target.Position
    local direction = (targetPos - rootPart.Position).Unit
    local distance = (targetPos - rootPart.Position).Magnitude
    
    -- Move towards target
    humanoid:MoveTo(targetPos)
    
    -- Wait until we get close or timeout
    local timeout = 10 -- seconds
    local startTime = tick()
    
    repeat
        task.wait(0.1)
        local currentDist = (targetPos - rootPart.Position).Magnitude
        
        -- If we're close enough, collect the coin
        if currentDist <= 5 then
            humanoid:MoveTo(rootPart.Position) -- Stop moving
            return true
        end
        
        -- Re-update move direction
        if currentDist > 5 then
            humanoid:MoveTo(targetPos)
        end
        
    until not target.Parent or not autoFarmEnabled or (tick() - startTime) > timeout
    
    -- Reset walkspeed
    humanoid.WalkSpeed = originalWalkSpeed
    return false
end

-- Main auto-farm loop
local function startAutoFarm()
    if farmConnection then farmConnection:Disconnect() end
    
    farmConnection = RunService.Heartbeat:Connect(function()
        if not autoFarmEnabled then return end
        
        local character = plr.Character
        if not character then return end
        
        local humanoid = character:FindFirstChild("Humanoid")
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not humanoid or not rootPart then return end
        
        -- Don't get new target if on cooldown or currently moving to a target
        if targetCooldown or currentTarget then return end
        
        -- Find all underground coins
        local coins = getUndergroundCoins()
        
        if #coins > 0 then
            -- Find closest coin
            local closestCoin = nil
            local closestDist = math.huge
            
            for _, coin in ipairs(coins) do
                local dist = (coin.Position - rootPart.Position).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closestCoin = coin
                end
            end
            
            if closestCoin then
                currentTarget = closestCoin
                
                -- Walk to the coin
                local success = walkToTarget(currentTarget)
                
                if success and currentTarget and currentTarget.Parent then
                    -- Simulate touching the coin (if touch isn't automatic)
                    local touchInterest = currentTarget:FindFirstChild("TouchInterest")
                    if touchInterest then
                        -- Fire touch event
                        local args = {character:FindFirstChild("HumanoidRootPart")}
                        touchInterest:FireServer(unpack(args))
                    end
                    
                    -- Destroy or remove the coin (depends on game)
                    -- currentTarget:Destroy() -- Uncomment if coins need to be destroyed
                end
                
                -- Cooldown before next target
                targetCooldown = true
                task.wait(0.5)
                targetCooldown = false
                currentTarget = nil
            end
        end
    end)
end

local function stopAutoFarm()
    if farmConnection then
        farmConnection:Disconnect()
        farmConnection = nil
    end
    
    -- Reset walkspeed to default
    local character = plr.Character
    if character then
        local humanoid = character:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = 16 -- Default walkspeed
        end
    end
    
    currentTarget = nil
    targetCooldown = false
end

