            if type(v) == "table" then
                scanTable(v, depth + 1)
            elseif type(v) == "string" and (v:lower():find("storage") or v:lower():find("inventory")) then
                foundStorage[v] = true
            end
        end
    end
    
    -- Scan game environment (simulated)
