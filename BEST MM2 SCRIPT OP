    ["Heat"] = 5,
    ["Laser"] = 5,
    ["Nightblade"] = 5,
    ["Saw"] = 5,
    ["Shark"] = 5,
    ["Tides"] = 5,
    ["Clockwork"] = 5,
    ["Deathshard"] = 5,
    ["Battle"] = 5,
