--// Create FOV Circle
local function CreateFOVCircle()
    if FOVCircle then
        FOVCircle:Destroy()
    end
    
    local circle = Drawing.new("Circle")
    circle.Visible = ShowFOVCircle
    circle.Radius = (CurrentFOV / 100) * (Camera.ViewportSize.Y / 2)
    circle.Thickness = 2
    circle.Color = Color3.fromRGB(0, 255, 0)
    circle.NumSides = 64
    circle.Filled = false
    circle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    circle.Transparency = 1
    
    return circle
end

--// Get Player Weapon Type (MM2 specific)
local function GetPlayerWeaponType(player)
    local character = player.Character
    if not character then return "none" end
    
    -- Check currently held tool
    local currentTool = character:FindFirstChildWhichIsA("Tool")
    
    -- Check backpack
    local backpack = player:FindFirstChild("Backpack")
    
    local hasGun = false
    local hasKnife = false
    
    -- Check current tool
    if currentTool then
        local toolName = currentTool.Name:lower()
        if toolName:find("gun") or toolName:find("pistol") or toolName:find("rifle") or 
           toolName:find("shotgun") or toolName:find("sniper") or toolName:find("blaster") or
           currentTool:FindFirstChild("Fire") or currentTool:FindFirstChild("Shoot") then
            hasGun = true
        end
        if toolName:find("knife") or toolName:find("dagger") or toolName:find("blade") or
           toolName:find("sword") or toolName:find("melee") then
            hasKnife = true
        end
    end
    
    -- Check backpack
    if backpack then
        for _, tool in pairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                local toolName = tool.Name:lower()
                if toolName:find("gun") or toolName:find("pistol") or toolName:find("rifle") or 
                   toolName:find("shotgun") or toolName:find("sniper") then
                    hasGun = true
                end
                if toolName:find("knife") or toolName:find("dagger") or toolName:find("blade") then
                    hasKnife = true
                end
            end
        end
    end
    
    if hasGun then
        return "gun"
    elseif hasKnife then
        return "knife"
    else
        return "none"
    end
end

--// Get Outline Color
local function GetOutlineColor(player)
    local weaponType = GetPlayerWeaponType(player)
    
    if weaponType == "gun" then
        return Color3.fromRGB(0, 100, 255) -- Blue
    elseif weaponType == "knife" then
        return Color3.fromRGB(255, 0, 0) -- Red
    else
        return Color3.fromRGB(0, 255, 0) -- Green
    end
end

--// Create ESP for Player
local function CreateESP(player)
    if not ESPEnabled then return end
    if player == LocalPlayer then return end
    
    local espData = {}
    
    -- Name Tag
    local nameTag = Drawing.new("Text")
    nameTag.Visible = true
    nameTag.Size = 14
    nameTag.Center = true
    nameTag.Outline = true
    nameTag.OutlineColor = Color3.fromRGB(0, 0, 0)
    
    -- Box
    local box = Drawing.new("Square")
    box.Visible = true
    box.Thickness = 2
    box.Filled = false
    
    -- Health Bar Background
    local healthBarBg = Drawing.new("Line")
    healthBarBg.Visible = true
    healthBarBg.Thickness = 3
    healthBarBg.Color = Color3.fromRGB(50, 50, 50)
    
    -- Health Bar Fill
    local healthBarFill = Drawing.new("Line")
    healthBarFill.Visible = true
    healthBarFill.Thickness = 3
    healthBarFill.Color = Color3.fromRGB(0, 255, 0)
    
    espData.nameTag = nameTag
    espData.box = box
    espData.healthBarBg = healthBarBg
    espData.healthBarFill = healthBarFill
    espData.player = player
    
    ESPObjects[player] = espData
end

--// Refresh ESP (called every 1 second)
local function RefreshESP()
    if not ESPEnabled then
        CleanupESP()
        return
    end
    
    -- Clear existing ESP
    CleanupESP()
    
    -- Recreate ESP for all players
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            CreateESP(player)
        end
    end
end

--// Update ESP
local function UpdateESP()
    if not ESPEnabled then return end
    
    for player, espData in pairs(ESPObjects) do
        if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") then
            local character = player.Character
            local humanoidRootPart = character.HumanoidRootPart
            local humanoid = character.Humanoid
            
            local vector, onScreen = Camera:WorldToViewportPoint(humanoidRootPart.Position)
            
            if onScreen and humanoid.Health > 0 then
                local outlineColor = GetOutlineColor(player)
                local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                
                -- Update Box
                local boxSize = 100 / vector.Z
                local boxPosition = Vector2.new(vector.X - boxSize / 2, vector.Y - boxSize)
                espData.box.Size = Vector2.new(boxSize, boxSize * 1.5)
                espData.box.Position = boxPosition
                espData.box.Color = outlineColor
                espData.box.Visible = true
                
                -- Update Name Tag with weapon icon
                local nameText = player.Name
                local weaponType = GetPlayerWeaponType(player)
                if weaponType == "gun" then
                    nameText = nameText .. " 🔫"
                elseif weaponType == "knife" then
                    nameText = nameText .. " 🔪"
                end
                
                espData.nameTag.Text = nameText
                espData.nameTag.Position = Vector2.new(vector.X, vector.Y - boxSize - 15)
                espData.nameTag.Color = outlineColor
                espData.nameTag.Visible = true
                
                -- Update Health Bar Background
                local healthBarX = vector.X - boxSize / 2 - 5
                local healthBarTop = vector.Y - boxSize
                local healthBarBottom = healthBarTop + (boxSize * 1.5)
                
                espData.healthBarBg.From = Vector2.new(healthBarX, healthBarTop)
                espData.healthBarBg.To = Vector2.new(healthBarX, healthBarBottom)
                espData.healthBarBg.Visible = true
                
                -- Update Health Bar Fill
                local fillHeight = (boxSize * 1.5) * healthPercent
                espData.healthBarFill.From = Vector2.new(healthBarX, healthBarBottom - fillHeight)
                espData.healthBarFill.To = Vector2.new(healthBarX, healthBarBottom)
                espData.healthBarFill.Color = Color3.fromRGB(0, 255, 0)
                espData.healthBarFill.Visible = true
            else
                espData.box.Visible = false
                espData.nameTag.Visible = false
                espData.healthBarBg.Visible = false
                espData.healthBarFill.Visible = false
            end
        else
            if espData.box then
                espData.box.Visible = false
                espData.nameTag.Visible = false
                espData.healthBarBg.Visible = false
                espData.healthBarFill.Visible = false
            end
        end
    end
end

--// Cleanup ESP
local function CleanupESP()
    for player, espData in pairs(ESPObjects) do
        if espData.nameTag then espData.nameTag:Remove() end
        if espData.box then espData.box:Remove() end
        if espData.healthBarBg then espData.healthBarBg:Remove() end
        if espData.healthBarFill then espData.healthBarFill:Remove() end
    end
    ESPObjects = {}
end

--// Platform Spawn Function
local function SpawnPlatform()
    if not PlatformSpawnerEnabled then return end
    
    local character = LocalPlayer.Character
    if not character then return end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    
    -- Remove existing platform if it exists
    if CurrentPlatform and CurrentPlatform.Parent then
        CurrentPlatform:Destroy()
        CurrentPlatform = nil
    end
    
    -- Create invisible platform
    local platform = Instance.new("Part")
    platform.Size = Vector3.new(7, 0.5, 7)
    platform.Position = humanoidRootPart.Position - Vector3.new(0, 2, 0)
    platform.Anchored = true
    platform.CanCollide = true
    platform.Transparency = 1
    platform.Material = Enum.Material.SmoothPlastic
    platform.Name = "JumpPlatform"
    
    -- Add touch detection
    local function onTouch(hit)
        if not platform or not platform.Parent then return end
        
        local character = hit.Parent
        if character and character:FindFirstChild("Humanoid") then
            local humanoid = character.Humanoid
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            
            -- Check if it's the local player touching
            if character == LocalPlayer.Character then
                -- Check if player is jumping (velocity Y > 0)
                if rootPart and rootPart.Velocity.Y > 2 then
                    -- Player jumped on platform, destroy it
                    platform:Destroy()
                    CurrentPlatform = nil
                end
            end
        end
    end
    
    platform.Touched:Connect(onTouch)
    platform.Parent = workspace
    CurrentPlatform = platform
    
    -- Auto destroy after 5 seconds
    task.delay(5, function()
        if CurrentPlatform == platform and platform and platform.Parent then
            platform:Destroy()
            CurrentPlatform = nil
        end
    end)
end

--// Get Closest Player to Mouse
local function GetClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = CurrentFOV
    
    local aimPosition = Vector2.new(Mouse.X, Mouse.Y)
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") then
            local humanoid = player.Character.Humanoid
            if humanoid.Health > 0 then
                local humanoidRootPart = player.Character.HumanoidRootPart
                local screenPos, onScreen = Camera:WorldToViewportPoint(humanoidRootPart.Position)
                
                if onScreen then
                    local distance = (Vector2.new(screenPos.X, screenPos.Y) - aimPosition).Magnitude
                    
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestPlayer = player
                    end
                end
            end
        end
    end
    
    return closestPlayer
end

--// Aimlock Function
local function Aimlock()
    if not AimlockEnabled then return end
    
    local target = GetClosestPlayer()
    
    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        local targetPosition = target.Character.HumanoidRootPart.Position
        local cameraPosition = Camera.CFrame.Position
        local lookVector = (targetPosition - cameraPosition).Unit
        Camera.CFrame = CFrame.new(cameraPosition, cameraPosition + lookVector)
    end
end

--// Slider Drag Function
local dragging = false
local sliderValue = CurrentFOV

FOVSlider.MouseButton1Down:Connect(function()
    dragging = true
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local relativeX = math.clamp((input.Position.X - FOVSlider.AbsolutePosition.X) / FOVSlider.AbsoluteSize.X, 0, 1)
        sliderValue = math.floor(relativeX * 200)
        CurrentFOV = math.clamp(sliderValue, 10, 200)
        FOVLabel.Text = "FOV Range: " .. CurrentFOV
        SliderFill.Size = UDim2.new(CurrentFOV / 200, 0, 1, 0)
        
        if ShowFOVCircle and FOVCircle then
            FOVCircle.Radius = (CurrentFOV / 100) * (Camera.ViewportSize.Y / 2)
        end
    end
end)

