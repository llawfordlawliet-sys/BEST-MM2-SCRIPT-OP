    mainFrame.Visible = false
    screenGui.Enabled = false
end)

closeBtn.TouchTap:Connect(function()
    mainFrame.Visible = false
    screenGui.Enabled = false
end)

-- Minimize/Restore GUI
local minimized = false
minBtn.MouseButton1Click:Connect(function()
    if minimized then
        -- Restore
        local tween = game:GetService("TweenService"):Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 500, 0, 350)
        })
        tween:Play()
        contentArea.Visible = true
        minimized = false
    else
        -- Minimize
        local tween = game:GetService("TweenService"):Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 150, 0, 40)
        })
        tween:Play()
        contentArea.Visible = false
        minimized = true
    end
end)

minBtn.TouchTap:Connect(function()
    if minimized then
        local tween = game:GetService("TweenService"):Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 500, 0, 350)
        })
        tween:Play()
        contentArea.Visible = true
        minimized = false
    else
        local tween = game:GetService("TweenService"):Create(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 150, 0, 40)
        })
        tween:Play()
        contentArea.Visible = false
        minimized = true
    end
end)

-- ============================================
-- LOADING ANIMATION
-- ============================================
local loadingSteps = {
    "Initializing Yagami Hub...",
    "Loading assets...",
    "Connecting to server...",
    "Setting up UI...",
    "Loading modules...",
    "Almost ready...",
    "Welcome to Yagami Hub!"
}

local stepIndex = 1
for i = 1, 100 do
    wait(0.025)
    
    -- Update progress bar
    progressFill.Size = UDim2.new(i / 100, 0, 1, 0)
    percentText.Text = i .. "%"
    
    -- Update subtitle text based on progress
    if i >= stepIndex * 14 and stepIndex <= #loadingSteps then
        subText.Text = loadingSteps[stepIndex]
        stepIndex = stepIndex + 1
    end
    
    -- Change color as it loads
    local hue = 0.55 + (i / 100) * 0.2
    progressFill.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
end

