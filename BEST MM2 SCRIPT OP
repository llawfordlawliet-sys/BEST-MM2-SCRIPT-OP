-- ============================================
-- TEST 5: TRADE EXECUTION
-- ============================================

local function testTradeExecution(targetPlayer)
    local steps = {
        sendRequest = false,
        addItems = false,
        acceptTrade = false,
        completeTrade = false
    }
    
    pcall(function()
        local startTrade = ReplicatedStorage:FindFirstChild("StartTrade")
        local offerItem = ReplicatedStorage:FindFirstChild("OfferItem")
        local acceptTrade = ReplicatedStorage:FindFirstChild("AcceptTrade")
        local completeTrade = ReplicatedStorage:FindFirstChild("CompleteTrade")
        
        if startTrade then
            startTrade:FireServer(targetPlayer)
            steps.sendRequest = true
            wait(0.5)
        end
        
        if offerItem and player.Backpack:GetChildren()[1] then
            offerItem:FireServer(player.Backpack:GetChildren()[1])
            steps.addItems = true
            wait(0.5)
        end
        
        if acceptTrade then
            acceptTrade:FireServer()
            steps.acceptTrade = true
            wait(0.5)
        end
        
        if completeTrade then
            completeTrade:FireServer()
            steps.completeTrade = true
        end
    end)
    
    local allSuccess = steps.sendRequest and steps.addItems and steps.acceptTrade and steps.completeTrade
    
    if allSuccess then
        updateStatus("tradeComplete", "✅ SUCCESS", "All trade steps executed")
    else
        local failed = {}
        for step, success in pairs(steps) do
            if not success then table.insert(failed, step) end
        end
        updateStatus("tradeComplete", "❌ FAILED", "Failed steps: " .. table.concat(failed, ", "))
    end
    
    return allSuccess
end

-- ============================================
-- DETECT ANTI-CHEAT RESPONSE
-- ============================================

local function detectAntiCheatResponse()
    local detected = false
    local responses = {}
    
    game:GetService("Players").LocalPlayer.OnTeleport:Connect(function()
        table.insert(responses, "Teleport/Kick detected")
        detected = true
    end)
    
    local originalCount = #player.Backpack:GetChildren()
    wait(2)
    local newCount = #player.Backpack:GetChildren()
    
    if newCount < originalCount then
        table.insert(responses, "Items removed by server")
        detected = true
    end
    
    if detected then
        updateStatus("antiCheatDetected", "✅ DETECTED", table.concat(responses, ", "))
    else
        updateStatus("antiCheatDetected", "❌ NOT DETECTED", "No anti-cheat response observed")
    end
    
    return detected
end

